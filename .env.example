# Vorlage. Echte Werte gehoeren NICHT ins Repository.
#
# Buildzeit (Astro, Praefix PUBLIC_ = im Browser sichtbar):
#   Optional. Ist der Key gesetzt, rendert das Kontaktformular ein
#   Cloudflare-Turnstile-Widget. Ohne Key greifen Honeypot,
#   Zeitpruefung und Rate-Limit.
PUBLIC_TURNSTILE_SITE_KEY=

# Laufzeit (Cloudflare Pages Functions).
# Secrets werden gesetzt mit:
#   wrangler pages secret put <NAME> --project-name mk-stressfrei
BREVO_API_KEY=
TURNSTILE_SECRET_KEY=

# Normale Umgebungsvariablen (Cloudflare-Dashboard oder wrangler):
MAIL_FROM="MK Stressfrei <anfrage@send.sakalli.ai>"
MAIL_TO=emosa7758@gmail.com

# Erst zum Go-Live setzen. Leitet *.pages.dev per 301 auf die
# Kundendomain um.
CANONICAL_HOST=
