/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: index, follow
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; manifest-src 'self'; upgrade-insecure-requests

# Der Formular-Endpunkt gehoert nicht in den Index.
/api/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Von Astro gehashte Assets sind unveraenderlich. Dort liegen auch die
# beiden Logodateien, deshalb bekommt ein neues Logo automatisch eine
# neue Adresse.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Diese vier brauchen feste Namen: Favicon, Touch-Icon und Manifest-Icon
# werden vom Browser ueber den Pfad gefunden, das Vorschaubild von den
# sozialen Netzwerken. Sie koennen deshalb nicht gehasht werden und
# bekommen eine kurze Frist, damit eine Markenaenderung nicht wochenlang
# im Browserspeicher haengen bleibt.
#
# Eine Sammelregel wie `/*.png` gibt es bewusst nicht mehr. Cloudflare
# fuehrt alle passenden Regeln zusammen, dabei hat die Sammelregel die
# genaueren ueberschrieben: das gehashte Logo kam mit 30 Tagen statt
# einem Jahr heraus, das Favicon mit 30 Tagen statt einem Tag. Ausser
# den vier Dateien hier liegt ohnehin kein Bild mehr ausserhalb von
# `/_astro/`.
/favicon-32.png
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

/icon-512.png
  Cache-Control: public, max-age=86400, must-revalidate

/og.jpg
  Cache-Control: public, max-age=86400, must-revalidate

# HTML immer frisch pruefen, damit Inhaltsaenderungen sofort ankommen.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
