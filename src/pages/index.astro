---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import Hero from '../components/Hero.astro';
import Emergency from '../components/Emergency.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Costs from '../components/Costs.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { faqs } from '../data/site';
import { faqSchema } from '../lib/schema';

const origin = (Astro.site ?? new URL('https://mk-stressfrei.sakalli.ai')).origin;
---

<Layout home schema={[faqSchema(faqs, `${origin}/#faq`)]}>
  <Intro slot="intro" />
  <Hero />
  <Emergency />
  <Services />
  <Process />
  <Costs />
  <About />
  <Faq />
  <Contact />
</Layout>
