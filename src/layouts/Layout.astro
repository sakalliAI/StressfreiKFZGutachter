---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { company, seo, services } from '../data/site';

export interface Crumb {
  readonly name: string;
  readonly path: string;
}

interface Props {
  /** Vollstaendiger Seitentitel. Ohne Angabe gilt der der Startseite. */
  title?: string;
  description?: string;
  /** Pfad ohne Startseite, etwa [{ name: 'Leistungen', path: '/leistungen/' }]. */
  breadcrumbs?: readonly Crumb[];
  /** Weitere Schema.org-Knoten nur fuer diese Seite. */
  schema?: readonly Record<string, unknown>[];
  noindex?: boolean;
  /** Startseite: Scrollspy auf Sektionen, Opener, Anker statt Links. */
  home?: boolean;
  /** Welcher Navigationspunkt auf einer Unterseite als aktuell gilt. */
  current?: string;
}

const {
  title = seo.title,
  description = seo.description,
  breadcrumbs = [],
  schema = [],
  noindex = false,
  home = false,
  current,
} = Astro.props;

const site = Astro.site ?? new URL('https://mk-stressfrei.sakalli.ai');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(seo.ogImage, site);
const origin = site.origin;

/*
  Schema.org, Kern auf jeder Seite.

  ProfessionalService statt AutomotiveBusiness: begutachtet wird das
  Fahrzeug, es wird aber keine Leistung am Fahrzeug erbracht. Der Knoten
  hat eine feste @id und steht auf jeder Seite gleich. Unterseiten
  verweisen darauf, statt ihn zu wiederholen.
*/
const business = {
  '@type': 'ProfessionalService',
  '@id': `${origin}/#business`,
  name: company.name,
  alternateName: company.shortName,
  description: seo.description,
  url: `${origin}/`,
  telephone: company.phoneIntl,
  email: company.email,
  image: ogImage.href,
  logo: `${origin}/icon-512.png`,
  priceRange: '€€',
  founder: { '@type': 'Person', name: company.owner },
  knowsLanguage: ['de'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.zip,
    addressLocality: company.city,
    addressRegion: company.state,
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.office.lat,
    longitude: company.office.lon,
  },
  areaServed: [
    { '@type': 'City', name: company.city },
    ...company.places.map((place) => ({
      '@type': 'City',
      name: place.fullName,
      url: `${origin}/kfz-gutachter/${place.slug}/`,
    })),
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Leistungen',
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: service.title,
        url: `${origin}/leistungen/${service.slug}/`,
      },
    })),
  },
};

const website = {
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  url: `${origin}/`,
  name: company.name,
  inLanguage: 'de-DE',
  publisher: { '@id': `${origin}/#business` },
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Startseite', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(crumb.path, site).href,
        })),
      }
    : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [business, website, ...(breadcrumbList ? [breadcrumbList] : []), ...schema],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0a1226" />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a
      href="#hauptinhalt"
      class="focus:bg-copper-500 focus:text-navy-950 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-200 focus:rounded-lg focus:px-4 focus:py-3 focus:font-semibold"
    >
      Zum Hauptinhalt springen
    </a>

    <slot name="intro" />
    <Header home={home} current={current} />

    <main id="hauptinhalt">
      <slot />
    </main>

    <Footer />
    <StickyCta />

    {
      /*
      Merkt sich, dass in dieser Sitzung schon eine Seite gezeigt wurde.
      Der Opener auf der Startseite laeuft nur, wenn sie die erste Seite
      des Besuchs ist. Wer ueber Google auf einer Leistungsseite landet
      und dann zur Startseite wechselt, will kein Intro mehr sehen.
      Steht bewusst am Ende: der Opener liest den Wert vorher.
    */
    }
    <script is:inline>
      try {
        sessionStorage.setItem('mk-seen', '1');
      } catch {
        /* privater Modus: dann laeuft der Opener eben noch einmal */
      }
    </script>
  </body>
</html>

<script>
  /* --------------------------------------------------------------
     Scroll-Reveal.

     Die Startwerte setzt erst diese Klasse am <html>. Bleibt das Script
     aus, ist der Inhalt trotzdem sichtbar. Das ist der Grund, warum nach
     einem Deploy nie ein leerer Bereich unter dem Hero stehen kann.
     -------------------------------------------------------------- */
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (targets.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('js-reveal-ready');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );

    for (const target of targets) observer.observe(target);

    // Sicherheitsnetz: Was nach 2.5s noch nicht eingeblendet wurde,
    // wird hart sichtbar gemacht.
    window.setTimeout(() => {
      for (const target of targets) target.classList.add('is-in');
    }, 2500);
  }
</script>
