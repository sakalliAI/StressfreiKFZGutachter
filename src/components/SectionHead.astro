---
/**
 * Ueberschrift einer Sektion auf der Startseite.
 *
 * Ohne Ueberzeile. Die Kombination aus kleiner Kategoriezeile mit
 * Strich, grosser Ueberschrift und grauer Einleitung ueber jeder Sektion
 * ist das deutlichste Erkennungszeichen von Baukasten-Seiten. Eine
 * Ueberschrift, die konkret sagt, worum es geht, braucht keine Zeile
 * darueber, die es noch einmal in einem Wort sagt.
 */
interface Props {
  title: string;
  lead?: string;
  id?: string;
  tone?: 'dark' | 'light';
  class?: string;
}

const { title, lead, id, tone = 'dark', class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', className]} data-reveal>
  <h2
    id={id}
    class:list={[
      'text-[clamp(1.9rem,3vw+0.8rem,3rem)] font-bold',
      tone === 'light' ? 'text-navy-900' : 'text-bone-50',
    ]}
  >
    {title}
  </h2>
  {
    lead && (
      <p
        class:list={[
          'mt-4 text-[1.05rem] leading-relaxed',
          tone === 'light' ? 'text-navy-600' : 'text-navy-300',
        ]}
      >
        {lead}
      </p>
    )
  }
</div>
