---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import CoverageMap from './CoverageMap.astro';
import { company, trustPoints } from '../data/site';
import logo from '../assets/logo.webp';

/*
  Echtes Porträt, sobald es vorliegt: als src/assets/portrait.jpg (oder
  .jpeg/.png/.webp) ablegen, dann erscheint es hier automatisch. Bis
  dahin steht eine Visitenkarte ohne Foto. Ein fremdes Stockgesicht
  unter dem Namen des Inhabers waere irrefuehrend (§ 5 UWG).
*/
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default ?? null;
---

<section id="person" class="section-pad bg-navy-900" aria-labelledby="person-title">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-16">
      {
        /*
        Text.

        Steht bewusst vor der Bildspalte. So stimmt die Reihenfolge
        im Markup mit der Lesereihenfolge auf dem Handy überein, ohne
        dass Vorlesewerkzeuge und Tastaturbedienung einer anderen
        Abfolge folgen als das Auge.
      */
      }
      <div class="flex flex-col justify-start">
        <h2
          id="person-title"
          class="text-bone-50 text-[clamp(1.9rem,3vw+0.8rem,3rem)] font-bold"
          data-reveal
        >
          Sie bekommen keinen Sachbearbeiter. Sie bekommen mich.
        </h2>

        <div class="text-navy-300 mt-6 grid gap-4 text-[1rem] leading-relaxed" data-reveal>
          <p>
            Ich bin {company.owner}, DESAG geprüfter Kfz-Sachverständiger{
              company.city ? ` in ${company.city}` : ''
            }. Ich arbeite allein, ohne Büro dazwischen. Wer hier anruft, hat mich am Apparat und
            nicht die Zentrale.
          </p>
          <p>
            Ein Unfall ist Ärger genug. Dann kommen noch Fristen, Rückfragen der Versicherung und
            Papiere, die kein Mensch versteht. Das nehme ich Ihnen ab. Daher der Name.
          </p>
          <p class="border-copper-500 text-bone-100 border-l-2 pl-5">
            Bezahlt werde ich für ein sauberes Gutachten, nicht für ein bestimmtes Ergebnis. Von
            Werkstätten und Versicherungen nehme ich kein Geld an.
          </p>
        </div>

        <ul class="mt-8 grid gap-x-6 gap-y-4 sm:grid-cols-2" data-reveal>
          {
            trustPoints.map((point) => (
              <li class="flex gap-3">
                <Icon name="check" size={17} class="text-copper-400 mt-0.5 flex-none" />
                <span>
                  <span class="text-bone-50 block text-[0.92rem] font-semibold">{point.title}</span>
                  <span class="text-navy-400 mt-1 block text-[0.86rem] leading-relaxed">
                    {point.text}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      {
        /*
        Bildspalte: oben das Porträt, darunter die Karte.

        Das Porträt bekommt `flex-1` und keine feste Höhe. Damit nimmt
        es genau den Platz auf, den die Karte neben dem Text übrig
        lässt, und beide Spalten enden auf derselben Linie. Ein festes
        Seitenverhältnis hätte je nach Textlänge einen Rest ergeben.

        Im Markup steht sie hinter dem Text, damit auf dem Handy
        zuerst zu lesen ist, worum es geht. Ab der zweispaltigen
        Ansicht rückt sie über `lg:order-first` nach links.
      */
      }
      {
        /* Ein gemeinsames `data-reveal` fuer beide Kacheln. Getrennt
           bewegten sie sich waehrend des Einblendens gegeneinander und
           ueberlappten dabei kurz an der Kante. */
      }
      <div class="flex flex-col gap-5 lg:order-first" data-reveal>
        {
          portrait ? (
            <div class="rounded-card relative min-h-52 flex-1 overflow-hidden lg:min-h-40">
              <Image
                src={portrait}
                alt={`${company.owner}, Kfz-Sachverständiger`}
                widths={[420, 640, 900]}
                sizes="(min-width: 1024px) 34vw, 100vw"
                format="webp"
                quality={70}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-[50%_28%]"
              />
              <span
                class="absolute inset-0 bg-[linear-gradient(to_top,rgb(4_7_15/0.9),rgb(6_10_22/0.15)_62%)]"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 p-4">
                <p class="text-copper-400 text-[0.66rem] font-semibold tracking-[0.18em] uppercase">
                  Ihr Ansprechpartner
                </p>
                <p class="font-display text-bone-50 mt-1 text-lg font-bold">{company.owner}</p>
                <p class="text-navy-300 mt-0.5 text-[0.8rem]">DESAG geprüfter Sachverständiger</p>
              </div>
            </div>
          ) : (
            <div class="rounded-card bg-navy-850 relative flex flex-1 flex-col justify-end overflow-hidden border border-white/10 p-6">
              <img
                src={logo.src}
                alt=""
                width={logo.width}
                height={logo.height}
                loading="lazy"
                decoding="async"
                class="pointer-events-none absolute -top-4 -right-10 w-64 opacity-[0.12]"
              />
              <p class="text-copper-400 relative text-[0.7rem] font-semibold tracking-[0.18em] uppercase">
                Ihr Ansprechpartner
              </p>
              <p class="font-display text-bone-50 relative mt-1.5 text-2xl font-bold">
                {company.owner}
              </p>
              <p class="text-navy-300 relative mt-1 text-[0.9rem]">
                DESAG geprüfter Kfz-Sachverständiger
              </p>
              <a
                href={company.phoneHref}
                class="text-bone-50 hover:text-copper-300 relative mt-5 inline-flex items-center gap-2 text-[1.05rem] font-semibold transition-colors"
                data-track="call-person"
              >
                <Icon name="phone" size={17} class="text-copper-400" />
                {company.phoneDisplay}
              </a>
            </div>
          )
        }

        <div class="flex-none">
          <CoverageMap />
          <p class="text-navy-300 mt-3 text-[0.88rem] leading-relaxed">
            Unterwegs im Umkreis von rund {company.radiusKm} km.{' '}
            <a
              href="/kfz-gutachter/"
              class="text-copper-400 hover:text-copper-300 decoration-copper-500/40 font-semibold underline underline-offset-4"
              >Anfahrt und Fahrzeiten ansehen</a
            >
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
