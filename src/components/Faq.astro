---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import FaqList from './FaqList.astro';
import { faqs, company } from '../data/site';
---

<section id="faq" class="section-pad bg-navy-850" aria-labelledby="faq-title">
  <div class="container-page">
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)] lg:items-start lg:gap-14"
    >
      <div>
        <SectionHead id="faq-title" title="Was Mandanten vorher wissen wollen" />
        <div class="mt-9">
          <FaqList items={faqs} />
        </div>
        <p class="text-navy-300 mt-6 text-[0.92rem] leading-relaxed">
          Weitere Antworten stehen auf den Seiten der einzelnen{' '}
          <a
            href="/leistungen/"
            class="text-copper-400 hover:text-copper-300 decoration-copper-500/40 font-semibold underline underline-offset-4"
            >Leistungen</a
          >.
        </p>
      </div>

      {
        /* Nur ab Desktop. Auf dem Handy laege die Kachel direkt vor dem
          Kontaktbereich mit denselben Schaltflaechen. */
      }
      <aside class="hidden lg:sticky lg:top-[calc(var(--header-h)+2.5rem)] lg:block" data-reveal>
        <div class="rounded-card bg-navy-800 border border-white/10 p-6">
          <h3 class="text-bone-50 text-lg font-bold">Ihre Frage steht nicht dabei?</h3>
          <p class="text-navy-300 mt-2.5 text-[0.92rem] leading-relaxed">
            Schreiben Sie mir kurz. Ich antworte meistens innerhalb einer Stunde, auch am
            Wochenende.
          </p>
          <div class="mt-6 grid gap-2.5">
            <a
              href={company.whatsapp}
              target="_blank"
              rel="noopener"
              class="btn btn-wa w-full"
              data-track="wa-faq"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp schreiben
            </a>
            <a href={company.phoneHref} class="btn btn-ghost w-full" data-track="call-faq">
              <Icon name="phone" size={17} />
              {company.phoneDisplay}
            </a>
          </div>
          <p class="text-navy-400 mt-5 flex items-start gap-2 text-[0.8rem] leading-relaxed">
            <Icon name="clock" size={15} class="mt-0.5 flex-none" />
            {company.hours}
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>
