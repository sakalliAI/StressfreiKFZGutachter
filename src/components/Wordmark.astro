---
import logo from '../assets/logo.webp';

/**
 * Wortmarke aus dem Logo des Kunden.
 *
 * `src/assets/logo.webp` entsteht aus `brand/mkstress_logo_neu.png`,
 * siehe `scripts/build-assets.mjs`.
 *
 * Die Datei liegt bewusst in `src/assets` und nicht in `public`: Astro
 * haengt dort eine Pruefsumme an den Dateinamen. Ein neues Logo bekommt
 * damit eine neue Adresse, und Besucher sehen es sofort. Unter einem
 * festen Namen wie `/logo.webp` haetten sie bis zu 30 Tage lang das
 * alte Bild aus ihrem Browserspeicher gesehen. Die Masse kommen aus
 * demselben Import, so koennen sie nicht mehr von der Datei abweichen.
 *
 * Das Bildzeichen ist rund 2:1 breit. Der Schriftzug im Logo waere auf
 * Header-Hoehe unleserlich, deshalb steht der Name daneben als echter
 * Text. Das ist zugleich besser fuer Suchmaschinen.
 */
interface Props {
  class?: string;
  compact?: boolean;
  /** Erlaubt es, --logo-h lokal zu überschreiben, etwa im Footer. */
  style?: string;
}

const { class: className = '', compact = false, style } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 sm:gap-3 ${className}`} style={style}>
  <img
    src={logo.src}
    alt=""
    data-brand-logo
    width={logo.width}
    height={logo.height}
    class="h-[var(--logo-h)] w-auto flex-none drop-shadow-[0_2px_8px_rgb(0_0_0/0.6)] transition-[height] duration-400 ease-[cubic-bezier(0.22,1,0.36,1)]"
    loading="eager"
    decoding="sync"
  />
  {
    !compact && (
      <span class="sr-only flex-none flex-col leading-none sm:not-sr-only sm:flex">
        <span class="font-display text-bone-50 text-[1rem] font-bold tracking-[0.02em] drop-shadow-[0_1px_4px_rgb(0_0_0/0.55)]">
          Stressfrei
        </span>
        <span class="text-bone-200/80 mt-1 text-[0.63rem] font-semibold tracking-[0.2em] whitespace-nowrap uppercase drop-shadow-[0_1px_4px_rgb(0_0_0/0.55)]">
          KFZ-Gutachter
        </span>
      </span>
    )
  }
</span>
