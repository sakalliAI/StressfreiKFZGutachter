---
import logo from '../assets/logo.webp';
/**
 * Opener: zwei Lichtlinien-Fahrzeuge, Aufprall, aus dem Aufprall
 * entsteht die Marke, die dann in den Header fliegt.
 *
 * Die Idee kommt aus dem Logo selbst: das M ist Chrom, das K Kupfer, und
 * ueber beiden liegt eine Fahrzeuglinie. Also faehrt von links ein
 * Wagen in Chrom, von rechts einer in Kupfer, beide gezeichnet als
 * Lichtkontur im Stil dieser Linie. Beim Aufprall verschmelzen sie zu
 * genau diesem Zeichen.
 *
 * Technik: SVG und CSS fuer alles Flaechige, ein kurzlebiges Canvas nur
 * fuer die Funken (rund 1,5 s, danach wird es entfernt). Wenige
 * Kilobyte, scharf auf jedem Display, kein Video, kein Autoplay-Thema.
 *
 * Ablauf (ms ab Start):
 *      0  Nacht, Fahrbahn glimmt auf
 *    100  beide Wagen zeichnen sich und beschleunigen aufeinander zu
 *   1220  Aufprall: Blitz, Schockwelle, Funken, Glas, Erschuetterung
 *   1320  Logo waechst aus dem Licht, Glanz faehrt darueber
 *   1750  Schriftzug
 *   3000  Logo fliegt an seinen Platz im Header, die Nacht oeffnet
 *         sich kreisfoermig und gibt die Seite frei
 *   4050  Ende
 *
 * Robustheit: Das Overlay steht per `hidden` im HTML und wird nur vom
 * Inline-Script eingeblendet. Faellt JavaScript aus, sieht man sofort
 * die Seite.
 */

const NAME = 'Stressfrei';

// Seitenprofil eines Coupés, Front rechts. Weiche Kurven statt Ecken.
const BODY =
  'M16 60C9 58 7 50 11 45L30 37C52 31 68 19 94 15C112 12 133 11 147 14C163 18 173 27 185 33C205 35 222 37 229 43C234 48 234 55 229 60L203 60A22 22 0 0 0 159 60L85 60A22 22 0 0 0 41 60Z';
const GLASS = 'M72 35C82 24 97 20 113 19L138 19C150 21 160 27 168 34Z';

const cars = [
  { side: 'l', stroke: 'url(#ic-chrome)', glow: 'rgb(220 230 255 / 0.55)' },
  { side: 'r', stroke: 'url(#ic-copper)', glow: 'rgb(238 159 102 / 0.65)' },
] as const;
---

<div id="intro" class="intro" hidden aria-hidden="true">
  <svg width="0" height="0" class="absolute" focusable="false">
    <defs>
      <linearGradient id="ic-chrome" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="0.55" stop-color="#c9d2e6"></stop>
        <stop offset="1" stop-color="#7c89ab"></stop>
      </linearGradient>
      <linearGradient id="ic-copper" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#ffe2c8"></stop>
        <stop offset="0.5" stop-color="#ee9f66"></stop>
        <stop offset="1" stop-color="#a5561e"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="intro__bg"></div>

  <div class="intro__stage">
    <div class="intro__road"></div>
    <div class="intro__floor"></div>

    {
      cars.map((car) => (
        <div class={`intro__car intro__car--${car.side}`} style={`--glow:${car.glow}`}>
          <span class="intro__trail" />
          <span class="intro__beam" />
          <div class="intro__flip">
            {['main', 'mirror'].map((kind) => (
              <svg
                viewBox="0 0 240 80"
                class={`intro__svg intro__svg--${kind}`}
                aria-hidden="true"
                focusable="false"
              >
                <path class="intro__line" d={BODY} pathLength="1" stroke={car.stroke} />
                <path
                  class="intro__line intro__line--thin"
                  d={GLASS}
                  pathLength="1"
                  stroke={car.stroke}
                />
                <circle
                  class="intro__line"
                  cx="63"
                  cy="61"
                  r="15"
                  pathLength="1"
                  stroke={car.stroke}
                />
                <circle
                  class="intro__line"
                  cx="181"
                  cy="61"
                  r="15"
                  pathLength="1"
                  stroke={car.stroke}
                />
                <ellipse class="intro__lamp" cx="224" cy="45" rx="5" ry="2.6" />
                <ellipse class="intro__tail" cx="14" cy="49" rx="3" ry="2.4" />
              </svg>
            ))}
          </div>
        </div>
      ))
    }

    <span class="intro__shock"></span>
    <span class="intro__shock intro__shock--wide"></span>
    <span class="intro__flash"></span>
  </div>

  <div class="intro__brand">
    <span class="intro__bloom"></span>
    <span class="intro__mark">
      <img
        class="intro__logo"
        id="intro-logo"
        src={logo.src}
        alt=""
        width={logo.width}
        height={logo.height}
        fetchpriority="high"
      />
      <span class="intro__sheen"></span>
    </span>
    <span class="intro__name">
      {
        NAME.split('').map((ch, i) => (
          <span class="intro__ch" style={`--i:${i}`}>
            {ch}
          </span>
        ))
      }
    </span>
    <span class="intro__sub">Kfz-Gutachter · Ingolstadt</span>
  </div>

  <button type="button" class="intro__skip" id="intro-skip">Überspringen</button>
</div>

<style>
  @property --iris {
    syntax: '<length>';
    inherits: false;
    initial-value: -20vmax;
  }

  @property --reveal {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  .intro {
    --car-w: clamp(136px, 24vw, 320px);
    --car-h: calc(var(--car-w) / 3);
    --impact: 1220ms;

    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    contain: strict;
  }

  .intro[hidden] {
    display: none;
  }

  /* ---------- Nacht ---------- */

  .intro__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 55% at 50% 50%, rgb(30 47 82 / 0.55), transparent 70%),
      radial-gradient(140% 120% at 50% 50%, #0b1428 0%, #03060d 75%);
    -webkit-mask-image: radial-gradient(
      circle at 50% 46%,
      transparent var(--iris),
      #000 calc(var(--iris) + 14vmax)
    );
    mask-image: radial-gradient(
      circle at 50% 46%,
      transparent var(--iris),
      #000 calc(var(--iris) + 14vmax)
    );
  }

  .intro.is-landing .intro__bg {
    animation:
      intro-iris 1000ms cubic-bezier(0.65, 0, 0.35, 1) 120ms both,
      intro-fade 260ms ease-out 900ms both;
  }

  @keyframes intro-iris {
    to {
      --iris: 120vmax;
    }
  }

  @keyframes intro-fade {
    to {
      opacity: 0;
    }
  }

  .intro__stage {
    position: absolute;
    inset: 0;
    animation:
      intro-shake 420ms linear var(--impact) both,
      intro-fade 420ms ease-out calc(var(--impact) + 520ms) both;
  }

  @keyframes intro-shake {
    0% {
      transform: translate(0, 0);
    }
    12% {
      transform: translate(-9px, 5px);
    }
    24% {
      transform: translate(8px, -6px);
    }
    38% {
      transform: translate(-6px, 3px);
    }
    52% {
      transform: translate(4px, -3px);
    }
    70% {
      transform: translate(-2px, 1px);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  /* Fahrbahn: eine leuchtende Linie, darunter ein spiegelnder Boden. */
  .intro__road {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(184 195 220 / 0.5) 20%,
      rgb(247 203 166 / 0.7) 50%,
      rgb(184 195 220 / 0.5) 80%,
      transparent
    );
    box-shadow: 0 0 18px 1px rgb(132 148 188 / 0.35);
    transform: scaleX(0);
    animation: intro-road 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes intro-road {
    to {
      transform: scaleX(1);
    }
  }

  .intro__floor {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 50%;
    background: radial-gradient(60% 40% at 50% 0%, rgb(79 102 160 / 0.16), transparent 70%);
    opacity: 0;
    animation: intro-in 700ms ease-out 200ms both;
  }

  @keyframes intro-in {
    to {
      opacity: 1;
    }
  }

  /* ---------- Fahrzeuge ---------- */

  .intro__car {
    position: absolute;
    top: calc(50% - var(--car-h));
    width: var(--car-w);
    height: calc(var(--car-h) * 2);
    will-change: transform, opacity;
  }

  .intro__car--l {
    right: 50%;
    animation: intro-car-l 1300ms 100ms both;
  }

  .intro__car--r {
    left: 50%;
    animation: intro-car-r 1300ms 100ms both;
  }

  .intro__car--r .intro__flip {
    transform: scaleX(-1);
  }

  .intro__flip {
    position: absolute;
    inset: 0;
  }

  /* Beschleunigt bis zum Aufprall, prallt dann leicht zurueck und
     verlischt. Die Kurve je Abschnitt steht im Keyframe selbst. */
  @keyframes intro-car-l {
    0% {
      transform: translateX(-62vw);
      opacity: 0;
      animation-timing-function: cubic-bezier(0.55, 0, 0.92, 0.5);
    }
    12% {
      opacity: 1;
    }
    86% {
      transform: translateX(calc(var(--car-w) * 0.03));
      opacity: 1;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    100% {
      transform: translateX(calc(var(--car-w) * -0.12)) rotate(-2.5deg);
      opacity: 1;
    }
  }

  @keyframes intro-car-r {
    0% {
      transform: translateX(62vw);
      opacity: 0;
      animation-timing-function: cubic-bezier(0.55, 0, 0.92, 0.5);
    }
    12% {
      opacity: 1;
    }
    86% {
      transform: translateX(calc(var(--car-w) * -0.03));
      opacity: 1;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    100% {
      transform: translateX(calc(var(--car-w) * 0.12)) rotate(2.5deg);
      opacity: 1;
    }
  }

  .intro__flip {
    animation: intro-car-out 460ms ease-in calc(var(--impact) + 140ms) both;
  }

  .intro__car--r .intro__flip {
    animation-name: intro-car-out-r;
  }

  @keyframes intro-car-out {
    to {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  @keyframes intro-car-out-r {
    to {
      opacity: 0;
      transform: scaleX(-1) scale(0.94);
    }
  }

  .intro__svg {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    overflow: visible;
  }

  .intro__svg--main {
    top: 0;
    filter: drop-shadow(0 0 6px var(--glow));
  }

  /* Spiegelung auf nasser Fahrbahn */
  .intro__svg--mirror {
    top: 50%;
    transform: scaleY(-1);
    opacity: 0.18;
    -webkit-mask-image: linear-gradient(to top, #000, transparent 70%);
    mask-image: linear-gradient(to top, #000, transparent 70%);
  }

  /* Die Kontur zeichnet sich waehrend der Fahrt. */
  .intro__line {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
    animation: intro-draw 900ms cubic-bezier(0.45, 0, 0.2, 1) 120ms forwards;
  }

  .intro__line--thin {
    stroke-width: 1.4;
    opacity: 0.75;
    animation-delay: 300ms;
  }

  @keyframes intro-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .intro__lamp {
    fill: #fff6ea;
    opacity: 0;
    animation: intro-in 300ms ease-out 450ms forwards;
  }

  .intro__tail {
    fill: #ff6a3d;
    opacity: 0;
    animation: intro-in 300ms ease-out 450ms forwards;
  }

  /* Lichtspur hinter dem Wagen, wird mit der Geschwindigkeit laenger. */
  .intro__trail {
    position: absolute;
    top: calc(var(--car-h) * 0.6);
    right: 96%;
    width: 46vw;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--glow));
    box-shadow: 0 0 10px 1px var(--glow);
    transform-origin: right center;
    animation: intro-trail 1300ms 100ms both;
  }

  .intro__car--r .intro__trail {
    right: auto;
    left: 96%;
    background: linear-gradient(270deg, transparent, var(--glow));
    transform-origin: left center;
  }

  @keyframes intro-trail {
    0% {
      transform: scaleX(0.1);
      opacity: 0;
    }
    30% {
      opacity: 0.9;
    }
    84% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(0.05);
      opacity: 0;
    }
  }

  /* Scheinwerferkegel nach vorn */
  .intro__beam {
    position: absolute;
    top: calc(var(--car-h) * 0.18);
    left: 92%;
    width: calc(var(--car-w) * 1.4);
    height: calc(var(--car-h) * 0.8);
    background: linear-gradient(90deg, rgb(255 246 234 / 0.32), transparent 80%);
    clip-path: polygon(0 44%, 100% 0, 100% 100%, 0 56%);
    mix-blend-mode: screen;
    transform-origin: left center;
    opacity: 0;
    animation: intro-beam 1300ms 100ms both;
  }

  .intro__car--r .intro__beam {
    left: auto;
    right: 92%;
    background: linear-gradient(270deg, rgb(255 246 234 / 0.32), transparent 80%);
    clip-path: polygon(100% 44%, 0 0, 0 100%, 100% 56%);
    transform-origin: right center;
  }

  @keyframes intro-beam {
    20% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    84% {
      opacity: 0.8;
      transform: scaleX(0.2);
    }
    100% {
      opacity: 0;
      transform: scaleX(0.1);
    }
  }

  /* ---------- Aufprall ---------- */

  .intro__flash {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% calc(50% - var(--car-h) * 0.45),
      #fff 0,
      rgb(255 236 214 / 0.85) 3vmax,
      rgb(238 159 102 / 0.28) 12vmax,
      transparent 32vmax
    );
    opacity: 0;
    mix-blend-mode: screen;
    animation: intro-flash 700ms cubic-bezier(0.2, 0.8, 0.3, 1) var(--impact) both;
  }

  @keyframes intro-flash {
    0% {
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Weiche Druckwelle: ein Ring aus Licht statt einer harten Kontur. */
  .intro__shock {
    position: absolute;
    top: calc(50% - var(--car-h) * 0.45);
    left: 50%;
    width: 40vmax;
    height: 40vmax;
    margin: -20vmax 0 0 -20vmax;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      transparent 56%,
      rgb(247 203 166 / 0.55) 64%,
      rgb(238 159 102 / 0.2) 68%,
      transparent 72%
    );
    opacity: 0;
    transform: scale(0.05);
    animation: intro-shock 900ms cubic-bezier(0.16, 1, 0.3, 1) var(--impact) both;
  }

  .intro__shock--wide {
    top: 50%;
    transform: scale(0.05, 0.02);
    animation-name: intro-shock-wide;
    animation-duration: 1100ms;
  }

  /* Erst ab 1 % sichtbar. Mit `both` gilt der erste Keyframe schon
     waehrend der Wartezeit, sonst stuende der Ring vorher in der Mitte. */
  @keyframes intro-shock {
    0% {
      opacity: 0;
      transform: scale(0.05);
    }
    1% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  @keyframes intro-shock-wide {
    0% {
      opacity: 0;
      transform: scale(0.05, 0.02);
    }
    1% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: scale(3.2, 0.32);
    }
  }

  .intro__fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---------- Marke ---------- */

  .intro__brand {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.9rem;
    padding-bottom: 4vh;
    pointer-events: none;
  }

  .intro__bloom {
    position: absolute;
    top: 46%;
    left: 50%;
    width: 70vmin;
    height: 70vmin;
    margin: -35vmin 0 0 -35vmin;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(221 125 56 / 0.28), transparent 62%);
    opacity: 0;
    animation: intro-bloom 1400ms ease-out calc(var(--impact) + 60ms) both;
  }

  @keyframes intro-bloom {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0.65;
      transform: scale(1);
    }
  }

  .intro.is-landing .intro__bloom {
    animation: none;
    opacity: 0;
    transition: opacity 500ms ease-out;
  }

  .intro__mark {
    position: relative;
    display: block;
    width: clamp(15rem, 40vw, 24rem);
  }

  /* Waechst aus dem Licht des Aufpralls: kreisfoermig freigelegt,
     leicht ueberbelichtet, dann auf normale Helligkeit. */
  /* Bewusst ohne opacity: 0. Verdeckt wird allein ueber die Maske.
     Fuer das Auge ist das gleich, der Browser zaehlt das Bild aber ab
     dem ersten Bild als gezeichnet (Largest Contentful Paint), statt
     erst nach dem Aufprall. */
  .intro__logo {
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image: radial-gradient(
      circle at 50% 50%,
      #000 calc(var(--reveal, 0%) - 14%),
      transparent var(--reveal, 0%)
    );
    mask-image: radial-gradient(
      circle at 50% 50%,
      #000 calc(var(--reveal, 0%) - 14%),
      transparent var(--reveal, 0%)
    );
    animation: intro-logo 900ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--impact) + 100ms) both;
  }

  @keyframes intro-logo {
    0% {
      --reveal: 0%;
      transform: scale(1.14);
      filter: brightness(2.4);
    }
    100% {
      --reveal: 100%;
      transform: scale(1);
      filter: brightness(1);
    }
  }

  /* Glanz, der ueber Chrom und Kupfer faehrt. Per `overlay` gemischt:
     auf hellem Metall wird daraus ein kraeftiger Lichtstreif, auf dem
     dunklen Grund daneben kaum mehr als ein Hauch. Bewusst ohne Maske
     aus dem Logo selbst, die haette das Bild ein zweites Mal geladen. */
  .intro__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        105deg,
        transparent 38%,
        rgb(255 255 255 / 0.85) 48%,
        rgb(255 240 225 / 0.4) 53%,
        transparent 62%
      ) -120%
      0 / 250% 100% no-repeat;
    -webkit-mask-image: radial-gradient(60% 60% at 50% 55%, #000 55%, transparent 100%);
    mask-image: radial-gradient(60% 60% at 50% 55%, #000 55%, transparent 100%);
    mix-blend-mode: overlay;
    opacity: 0;
    animation: intro-sheen 1100ms cubic-bezier(0.45, 0, 0.2, 1) calc(var(--impact) + 650ms) both;
  }

  @keyframes intro-sheen {
    0% {
      opacity: 0;
      background-position: -120% 0;
    }
    1% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      background-position: 220% 0;
    }
  }

  .intro__name {
    display: flex;
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.5rem, 2.4vw + 0.6rem, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #f7f8fc;
  }

  .intro__ch {
    display: inline-block;
    opacity: 0;
    animation: intro-ch 620ms cubic-bezier(0.22, 1, 0.36, 1)
      calc(var(--impact) + 520ms + var(--i) * 34ms) both;
  }

  @keyframes intro-ch {
    0% {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  .intro__sub {
    margin-top: -0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #b8c3dc;
    opacity: 0;
    animation: intro-sub 700ms ease-out calc(var(--impact) + 900ms) both;
  }

  @keyframes intro-sub {
    0% {
      opacity: 0;
      letter-spacing: 0.6em;
    }
    100% {
      opacity: 1;
      letter-spacing: 0.28em;
    }
  }

  .intro.is-landing .intro__name,
  .intro.is-landing .intro__sub {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 260ms ease-out,
      transform 260ms ease-out;
  }

  .intro.is-landing .intro__ch,
  .intro.is-landing .intro__sub,
  .intro.is-landing .intro__sheen {
    animation: none;
  }

  .intro.is-landing .intro__ch {
    opacity: 1;
  }

  /* ---------- Bedienung ---------- */

  .intro__skip {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: 1rem;
    z-index: 2;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: rgb(255 255 255 / 0.06);
    color: #b8c3dc;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      opacity 200ms ease;
  }

  .intro__skip:hover {
    background: rgb(255 255 255 / 0.14);
    color: #f7f8fc;
  }

  .intro.is-landing .intro__skip {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const el = document.getElementById('intro');
    if (!el) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /*
      Laeuft einmal je Browsersitzung und nur, wenn die Startseite die
      erste Seite des Besuchs ist (mk-seen setzt jede Seite am Ende).
      Zum Vorfuehren reicht `?intro` an der Adresse.
    */
    const force = /[?&]intro\b/.test(window.location.search);
    let seen = false;
    try {
      seen =
        sessionStorage.getItem('mk-intro') === '1' || sessionStorage.getItem('mk-seen') === '1';
    } catch {
      seen = false;
    }

    if (reduce || (seen && !force)) {
      el.remove();
      return;
    }

    const IMPACT = 1220;
    const LAND_AT = 3000;
    const LAND_MS = 850;
    const END_AT = LAND_AT + LAND_MS + 200;

    let done = false;
    let landTimer = 0;
    let endTimer = 0;
    let fxTimer = 0;
    let raf = 0;

    document.documentElement.style.overflow = 'hidden';
    // Header-Logo ausblenden, solange das Intro-Logo unterwegs ist.
    document.documentElement.classList.add('mk-intro-active');
    el.hidden = false;

    /**
     * Funken und Glas. Laeuft nur gut anderthalb Sekunden und entfernt
     * sich danach selbst. Partikel fliegen kegelfoermig nach oben,
     * fallen unter Schwerkraft und springen auf der Fahrbahn ab.
     */
    function sparks() {
      const stage = el.querySelector('.intro__stage');
      const car = el.querySelector('.intro__car');
      if (!stage || !car) return;

      const w = window.innerWidth;
      const h = window.innerHeight;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const canvas = document.createElement('canvas');
      canvas.className = 'intro__fx';
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      stage.appendChild(canvas);
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.scale(dpr, dpr);

      const carH = car.getBoundingClientRect().height / 2;
      const cx = w / 2;
      const cy = h / 2 - carH * 0.45;
      const floor = h / 2;
      const k = Math.min(1.5, Math.max(0.7, w / 1100));

      const parts = [];
      for (let i = 0; i < 170; i++) {
        const a = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.3;
        const speed = (2.5 + Math.random() * Math.random() * 15) * k;
        parts.push({
          x: cx + (Math.random() - 0.5) * 10,
          y: cy + (Math.random() - 0.5) * carH * 0.5,
          vx: Math.cos(a) * speed,
          vy: Math.sin(a) * speed,
          life: 0,
          max: 34 + Math.random() * 56,
          glass: i % 7 === 0,
          size: 2 + Math.random() * 4,
          rot: Math.random() * 6,
          spin: (Math.random() - 0.5) * 0.5,
        });
      }

      let last = performance.now();
      const start = last;

      function frame(now) {
        const dt = Math.min(3, (now - last) / 16.67);
        last = now;
        ctx.clearRect(0, 0, w, h);
        ctx.globalCompositeOperation = 'lighter';
        let alive = 0;

        for (const p of parts) {
          p.life += dt;
          if (p.life >= p.max) continue;
          alive++;
          p.vy += 0.34 * k * dt;
          p.vx *= Math.pow(0.986, dt);
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          if (p.y > floor) {
            p.y = floor;
            p.vy *= -0.36;
            p.vx *= 0.72;
          }
          const t = p.life / p.max;
          const alpha = 1 - t * t;

          if (p.glass) {
            p.rot += p.spin * dt;
            const glint = 0.35 + 0.65 * Math.abs(Math.sin(p.life * 0.5));
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = 'rgba(210, 225, 255,' + (alpha * glint).toFixed(3) + ')';
            ctx.beginPath();
            ctx.moveTo(-p.size, -p.size * 0.4);
            ctx.lineTo(p.size * 0.8, -p.size * 0.7);
            ctx.lineTo(p.size * 0.3, p.size * 0.8);
            ctx.closePath();
            ctx.fill();
            ctx.restore();
          } else {
            // Heiss: weiss, dann Kupfer, dann dunkles Orange.
            const g = Math.round(246 - 150 * t);
            const b = Math.round(234 - 200 * Math.min(1, t * 1.6));
            ctx.strokeStyle = 'rgba(255,' + g + ',' + b + ',' + alpha.toFixed(3) + ')';
            ctx.lineWidth = (1.9 - t * 1.3) * k;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(p.x - p.vx * 1.6, p.y - p.vy * 1.6);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
        }

        if (alive > 0 && now - start < 1900 && !done) {
          raf = requestAnimationFrame(frame);
        } else {
          canvas.remove();
        }
      }

      raf = requestAnimationFrame(frame);
    }

    /** Misst die Zielposition und schiebt das Logo dorthin (FLIP). */
    function land() {
      el.classList.add('is-landing');

      const logo = document.getElementById('intro-logo');
      const target = document.querySelector('[data-header] [data-brand-logo]');
      if (!logo || !target) return;

      const from = logo.getBoundingClientRect();
      const to = target.getBoundingClientRect();
      if (from.width === 0 || to.width === 0) return;

      const scale = to.width / from.width;
      const dx = to.left + to.width / 2 - (from.left + from.width / 2);
      const dy = to.top + to.height / 2 - (from.top + from.height / 2);

      // Keyframes ueberschreiben inline gesetzte Transformationen, also
      // erst entfernen und den Endzustand von Hand setzen.
      logo.style.animation = 'none';
      logo.style.opacity = '1';
      logo.style.filter = 'none';
      logo.style.transform = 'none';
      logo.style.maskImage = 'none';
      logo.style.webkitMaskImage = 'none';
      void logo.offsetWidth;

      logo.style.transition = 'transform ' + LAND_MS + 'ms cubic-bezier(0.65, 0, 0.25, 1)';
      logo.style.transform = 'translate(' + dx + 'px, ' + dy + 'px) scale(' + scale + ')';
    }

    function finish() {
      if (done) return;
      done = true;
      window.clearTimeout(landTimer);
      window.clearTimeout(endTimer);
      window.clearTimeout(fxTimer);
      cancelAnimationFrame(raf);
      document.documentElement.style.overflow = '';
      document.documentElement.classList.remove('mk-intro-active');
      try {
        sessionStorage.setItem('mk-intro', '1');
      } catch {
        // Nicht kritisch.
      }
      el.remove();
      document.removeEventListener('keydown', onKey);
    }

    function onKey(ev) {
      if (ev.key === 'Escape' || ev.key === 'Enter' || ev.key === ' ') finish();
    }

    /*
      Die Uhr startet mit der ersten CSS-Animation, nicht mit diesem
      Script. Der Browser beginnt die Keyframes erst beim naechsten
      Zeichnen, und das kann sich hinter dem Rest des Dokuments ein
      paar hundert Millisekunden verzoegern. Sonst flogen die Funken,
      bevor sich die Wagen beruehrten.
    */
    let started = false;
    function start() {
      if (started || done) return;
      started = true;
      fxTimer = window.setTimeout(sparks, IMPACT);
      landTimer = window.setTimeout(land, LAND_AT);
      endTimer = window.setTimeout(finish, END_AT);
    }
    const road = el.querySelector('.intro__road');
    if (road) road.addEventListener('animationstart', start, { once: true });
    // Falls das Ereignis ausbleibt, trotzdem sicher zu Ende kommen.
    window.setTimeout(start, 1200);
    document.addEventListener('keydown', onKey);
    el.addEventListener('click', finish);

    // Haengt ein Timer in einem Hintergrundtab, spaetestens beim
    // Zurueckkehren aufraeumen.
    window.addEventListener('pageshow', function () {
      if (!done && performance.now() > END_AT + 1700) finish();
    });
  })();
</script>
