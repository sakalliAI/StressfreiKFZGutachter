---
/**
 * Opener: zwei Fahrzeuge, Aufprall, Marke, Übergang in den Header.
 *
 * Bewusst als SVG plus CSS-Keyframes gebaut statt als Video oder
 * 3D-Szene. Gruende: wenige Kilobyte statt mehrerer Megabyte, gestochen
 * scharf auf jedem Display, kein Lizenzthema und kein Autoplay-Problem
 * auf iOS.
 *
 * Ablauf:
 *   0,00 s  Fahrbahnlinie zieht sich auf
 *   0,30 s  beide Fahrzeuge beschleunigen aufeinander zu
 *   1,45 s  Aufprall, Blitz, Schockwellen, Splitter
 *   1,70 s  die Flaeche teilt sich, die Seite wird sichtbar
 *   1,90 s  das Logo tritt an die Stelle der Fahrzeuge
 *   2,55 s  Logo steht, eine Sekunde Ruhe
 *   3,55 s  Logo fliegt an seinen Platz im Header
 *   4,35 s  Overlay verschwindet
 *
 * Robustheit: Das Overlay steht per `hidden` im HTML und wird nur von
 * einem Inline-Script eingeblendet. Faellt JavaScript aus, sieht der
 * Besucher sofort die Seite. Ohne diese Umkehr koennte ein Scriptfehler
 * die komplette Seite hinter einem schwarzen Layer verstecken.
 */

// Splitter des Aufpralls. Deterministisch berechnet, damit jeder Build
// identisch ist (kein Math.random zur Buildzeit).
const SHARDS = Array.from({ length: 16 }, (_, i) => {
  const angle = (i / 16) * Math.PI * 2 + (i % 3) * 0.21;
  const dist = 120 + ((i * 37) % 130);
  return {
    tx: Math.round(Math.cos(angle) * dist),
    ty: Math.round(Math.sin(angle) * dist * 0.68) - 18,
    rot: ((i * 71) % 300) - 150,
    size: 3 + (i % 4) * 2,
    delay: (i % 5) * 26,
  };
});
---

<div id="intro" class="intro" hidden aria-hidden="true">
  <div class="intro__panel intro__panel--top"></div>
  <div class="intro__panel intro__panel--bottom"></div>

  <div class="intro__stage">
    <div class="intro__road"></div>

    <!-- Fahrzeug links -->
    <div class="intro__car intro__car--l">
      <span class="intro__beam"></span>
      <svg viewBox="0 0 200 78" width="200" height="78" aria-hidden="true">
        <path
          d="M8 62V46q0-6 6-8l30-8 22-16q4-4 12-4h44q8 0 12 4l22 16 30 8q6 2 6 8v16z"
          fill="#e8ecf7"></path>
        <path d="M74 30 90 18h30l16 12z" fill="#1e2f52"></path>
        <rect x="186" y="40" width="8" height="7" rx="3" fill="#fff8e6"></rect>
        <circle cx="52" cy="62" r="13" fill="#04070f"></circle>
        <circle cx="52" cy="62" r="5" fill="#4f66a0"></circle>
        <circle cx="150" cy="62" r="13" fill="#04070f"></circle>
        <circle cx="150" cy="62" r="5" fill="#4f66a0"></circle>
      </svg>
    </div>

    <!-- Fahrzeug rechts -->
    <div class="intro__car intro__car--r">
      <span class="intro__beam"></span>
      <svg viewBox="0 0 200 78" width="200" height="78" aria-hidden="true">
        <path
          d="M8 62V46q0-6 6-8l30-8 22-16q4-4 12-4h44q8 0 12 4l22 16 30 8q6 2 6 8v16z"
          fill="#2c5fd8"></path>
        <path d="M74 30 90 18h30l16 12z" fill="#14213d"></path>
        <rect x="186" y="40" width="8" height="7" rx="3" fill="#fff8e6"></rect>
        <circle cx="52" cy="62" r="13" fill="#04070f"></circle>
        <circle cx="52" cy="62" r="5" fill="#4f66a0"></circle>
        <circle cx="150" cy="62" r="13" fill="#04070f"></circle>
        <circle cx="150" cy="62" r="5" fill="#4f66a0"></circle>
      </svg>
    </div>

    <div class="intro__impact">
      <span class="intro__ring"></span>
      <span class="intro__ring intro__ring--2"></span>
      {
        SHARDS.map((s) => (
          <span
            class="intro__shard"
            style={`--tx:${s.tx}px;--ty:${s.ty}px;--r:${s.rot}deg;--s:${s.size}px;--d:${s.delay}ms`}
          />
        ))
      }
    </div>

    <span class="intro__flash"></span>
  </div>

  <!-- Marke. Liegt ausserhalb der Buehne, weil sie bestehen bleibt,
       waehrend Fahrzeuge und Fahrbahn verschwinden. -->
  <div class="intro__brand">
    <img
      class="intro__logo"
      id="intro-logo"
      src="/logo.webp"
      alt=""
      width="640"
      height="211"
    />
    <span class="intro__name">Stressfrei</span>
    <span class="intro__sub">KFZ-Gutachter</span>
  </div>

  <button type="button" class="intro__skip" id="intro-skip">Überspringen</button>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    background: transparent;
  }

  .intro[hidden] {
    display: none;
  }

  /* Zwei Haelften, die auseinanderfahren und die Seite freigeben */
  .intro__panel {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50.4%;
    background: radial-gradient(120% 140% at 50% 50%, #0e1930 0%, #04070f 78%);
  }

  .intro__panel--top {
    top: 0;
  }

  .intro__panel--bottom {
    bottom: 0;
  }

  /* Erst mit dem Abflug des Logos gibt die Flaeche die Seite frei.
     Vorher steht die Marke auf dunklem Grund, nicht im Hero. */
  .intro.is-landing .intro__panel--top {
    animation: intro-panel-top 700ms cubic-bezier(0.76, 0, 0.24, 1) 100ms both;
  }

  .intro.is-landing .intro__panel--bottom {
    animation: intro-panel-bottom 700ms cubic-bezier(0.76, 0, 0.24, 1) 100ms both;
  }

  @keyframes intro-panel-top {
    to {
      transform: translateY(-101%);
    }
  }

  @keyframes intro-panel-bottom {
    to {
      transform: translateY(101%);
    }
  }

  .intro__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    animation: intro-stage-out 300ms ease-in 1560ms both;
  }

  @keyframes intro-stage-out {
    to {
      opacity: 0;
    }
  }

  .intro__road {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    margin-top: 39px;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(79 102 160 / 0.55) 22%,
      rgb(79 102 160 / 0.55) 78%,
      transparent
    );
    transform: scaleX(0);
    animation: intro-road 780ms cubic-bezier(0.22, 1, 0.36, 1) 80ms both;
  }

  @keyframes intro-road {
    to {
      transform: scaleX(1);
    }
  }

  .intro__car {
    position: absolute;
    width: 200px;
    height: 78px;
    will-change: transform;
  }

  .intro__car--l {
    animation: intro-car-l 1150ms cubic-bezier(0.5, 0.03, 0.88, 0.4) 300ms both;
  }

  .intro__car--r {
    transform: scaleX(-1);
    animation: intro-car-r 1150ms cubic-bezier(0.5, 0.03, 0.88, 0.4) 300ms both;
  }

  @keyframes intro-car-l {
    0% {
      transform: translateX(-68vw);
      opacity: 0;
    }
    14% {
      opacity: 1;
    }
    88% {
      transform: translateX(-88px);
      opacity: 1;
    }
    /* Ruecksprall */
    100% {
      transform: translateX(-116px) rotate(-3.5deg);
      opacity: 1;
    }
  }

  @keyframes intro-car-r {
    0% {
      transform: scaleX(-1) translateX(-68vw);
      opacity: 0;
    }
    14% {
      opacity: 1;
    }
    88% {
      transform: scaleX(-1) translateX(-88px);
      opacity: 1;
    }
    100% {
      transform: scaleX(-1) translateX(-116px) rotate(3.5deg);
      opacity: 1;
    }
  }

  .intro__car svg {
    animation: intro-car-fade 460ms ease-out 1500ms both;
  }

  @keyframes intro-car-fade {
    to {
      opacity: 0;
      filter: blur(3px);
    }
  }

  /* Scheinwerferkegel */
  .intro__beam {
    position: absolute;
    top: 32px;
    left: 186px;
    width: 46vw;
    height: 22px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(255 248 230 / 0.5), transparent 72%);
    filter: blur(9px);
    transform-origin: left center;
    animation: intro-beam 1150ms ease-in 300ms both;
  }

  @keyframes intro-beam {
    0% {
      opacity: 0;
      transform: scaleX(0.3);
    }
    35% {
      opacity: 0.9;
    }
    88% {
      opacity: 0.55;
      transform: scaleX(0.28);
    }
    100% {
      opacity: 0;
    }
  }

  /* Aufprall */
  .intro__impact {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
  }

  .intro__ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border: 2px solid var(--color-gold-400, #e9bc5a);
    border-radius: 50%;
    opacity: 0;
    animation: intro-ring 860ms cubic-bezier(0.16, 1, 0.3, 1) 1420ms both;
  }

  .intro__ring--2 {
    border-color: rgb(255 255 255 / 0.55);
    animation-delay: 1500ms;
    animation-duration: 720ms;
  }

  @keyframes intro-ring {
    0% {
      opacity: 0.95;
      transform: scale(0.2);
    }
    100% {
      opacity: 0;
      transform: scale(9);
    }
  }

  .intro__shard {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    background: var(--color-gold-300, #f4d68f);
    border-radius: 1px;
    opacity: 0;
    animation: intro-shard 900ms cubic-bezier(0.18, 0.9, 0.3, 1) calc(1420ms + var(--d)) both;
  }

  @keyframes intro-shard {
    0% {
      opacity: 1;
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    70% {
      opacity: 0.85;
    }
    100% {
      opacity: 0;
      transform: translate(var(--tx), var(--ty)) rotate(var(--r)) scale(0.3);
    }
  }

  .intro__flash {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      46% 46% at 50% 50%,
      #fff 0%,
      rgb(233 188 90 / 0.5) 38%,
      transparent 72%
    );
    opacity: 0;
    animation: intro-flash 520ms ease-out 1400ms both;
  }

  @keyframes intro-flash {
    0% {
      opacity: 0;
    }
    9% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Marke */
  .intro__brand {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.6rem;
    pointer-events: none;
  }

  .intro__logo {
    width: clamp(13rem, 34vw, 19rem);
    height: auto;
    opacity: 0;
    animation: intro-logo 650ms cubic-bezier(0.22, 1, 0.36, 1) 1700ms both;
  }

  @keyframes intro-logo {
    0% {
      opacity: 0;
      transform: scale(1.5);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  .intro__name {
    font-family: var(--font-display, sans-serif);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #f7f8fc;
    opacity: 0;
    animation: intro-up 560ms cubic-bezier(0.22, 1, 0.36, 1) 1900ms both;
  }

  .intro__sub {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8494bc;
    opacity: 0;
    animation: intro-up 560ms cubic-bezier(0.22, 1, 0.36, 1) 2000ms both;
  }

  @keyframes intro-up {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* Landeanflug: Schriftzug verschwindet, das Bildzeichen fliegt an
     seinen Platz im Header. Die Werte dafuer setzt das Script, weil
     die Zielposition erst zur Laufzeit bekannt ist. */
  .intro.is-landing .intro__name,
  .intro.is-landing .intro__sub {
    animation: none;
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  .intro__skip {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: 1rem;
    z-index: 2;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.07);
    color: #b8c3dc;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      opacity 200ms ease;
  }

  .intro__skip:hover {
    background: rgb(255 255 255 / 0.15);
    color: #f7f8fc;
  }

  .intro.is-landing .intro__skip {
    opacity: 0;
    pointer-events: none;
  }

  /* Kleine Viewports: Fahrzeuge kompakter */
  @media (max-width: 560px) {
    .intro__car,
    .intro__car svg {
      width: 148px;
      height: 58px;
    }
    .intro__beam {
      top: 24px;
      left: 138px;
      height: 16px;
    }
    .intro__road {
      margin-top: 29px;
    }
    @keyframes intro-car-l {
      0% {
        transform: translateX(-78vw);
        opacity: 0;
      }
      14% {
        opacity: 1;
      }
      88% {
        transform: translateX(-66px);
        opacity: 1;
      }
      100% {
        transform: translateX(-86px) rotate(-3.5deg);
        opacity: 1;
      }
    }
    @keyframes intro-car-r {
      0% {
        transform: scaleX(-1) translateX(-78vw);
        opacity: 0;
      }
      14% {
        opacity: 1;
      }
      88% {
        transform: scaleX(-1) translateX(-66px);
        opacity: 1;
      }
      100% {
        transform: scaleX(-1) translateX(-86px) rotate(3.5deg);
        opacity: 1;
      }
    }
  }

  /* Wer reduzierte Bewegung eingestellt hat, bekommt den Opener gar
     nicht erst zu sehen. Das Script prueft das zusaetzlich. */
  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const el = document.getElementById('intro');
    if (!el) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /*
      Der Opener laeuft einmal je Browsersitzung. Beim Neuladen bleibt er
      also weg, was fuer echte Besucher richtig ist: er verdeckt anfangs
      den Inhalt und wuerde sonst jedes Mal den ersten Bildaufbau
      verzoegern.

      Zum Vorfuehren reicht `?intro` an der Adresse, dann laeuft er
      trotzdem. Reduzierte Bewegung bleibt davon unberuehrt.
    */
    const force = /[?&]intro\b/.test(window.location.search);

    let seen = false;
    try {
      seen = sessionStorage.getItem('mk-intro') === '1';
    } catch {
      // Privater Modus ohne sessionStorage: Opener laeuft dann jedes Mal.
      seen = false;
    }

    if (reduce || (seen && !force)) {
      el.remove();
      return;
    }

    const LAND_AT = 3350; // Logo steht eine volle Sekunde, dann fliegt es
    const LAND_MS = 800; // Dauer des Flugs
    const END_AT = LAND_AT + LAND_MS + 60;

    const logo = document.getElementById('intro-logo');
    const target = document.querySelector('[data-header] [data-brand-logo]');

    let done = false;
    let landTimer = 0;
    let endTimer = 0;

    document.documentElement.style.overflow = 'hidden';
    el.hidden = false;

    // Solange der Opener laeuft, waere das Header-Logo ein zweites,
    // identisches Bildzeichen auf demselben Schirm.
    if (target) target.style.visibility = 'hidden';

    /** Misst die Zielposition und schiebt das Logo dorthin (FLIP). */
    function land() {
      el.classList.add('is-landing');

      if (!logo || !target) return;

      const from = logo.getBoundingClientRect();
      const to = target.getBoundingClientRect();
      if (from.width === 0 || to.width === 0) return;

      const scale = to.width / from.width;
      const dx = to.left + to.width / 2 - (from.left + from.width / 2);
      const dy = to.top + to.height / 2 - (from.top + from.height / 2);

      // Die Keyframe-Animation ueberschreibt inline gesetzte
      // Transformationen. Sie muss also erst weichen, danach werden ihre
      // Endwerte von Hand gesetzt.
      logo.style.animation = 'none';
      logo.style.opacity = '1';
      logo.style.filter = 'none';
      logo.style.transform = 'none';
      void logo.offsetWidth;

      logo.style.transition = 'transform ' + LAND_MS + 'ms cubic-bezier(0.66, 0, 0.24, 1)';
      logo.style.transform = 'translate(' + dx + 'px, ' + dy + 'px) scale(' + scale + ')';
    }

    function finish() {
      if (done) return;
      done = true;
      window.clearTimeout(landTimer);
      window.clearTimeout(endTimer);
      document.documentElement.style.overflow = '';
      if (target) target.style.visibility = '';
      try {
        sessionStorage.setItem('mk-intro', '1');
      } catch {
        // Nicht kritisch, der Opener laeuft dann beim naechsten Aufruf erneut.
      }
      el.remove();
      document.removeEventListener('keydown', onKey);
    }

    function onKey(ev) {
      if (ev.key === 'Escape' || ev.key === 'Enter' || ev.key === ' ') finish();
    }

    landTimer = window.setTimeout(land, LAND_AT);
    endTimer = window.setTimeout(finish, END_AT);
    document.addEventListener('keydown', onKey);
    el.addEventListener('click', finish);

    // Sicherheitsnetz: haengt ein Timer in einem Hintergrundtab,
    // spaetestens beim Zurueckkehren aufraeumen.
    window.addEventListener('pageshow', function () {
      if (!done && performance.now() > END_AT + 500) finish();
    });
  })();
</script>
