---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { company, processSteps } from '../data/site';
import photo from '../assets/begutachtung.jpeg';
---

<section id="ablauf" class="bg-navy-850 relative" aria-labelledby="ablauf-title">
  {
    /*
    Scroll-Strecke. Der innere Block bleibt stehen, während die Seite
    daran vorbeiläuft. Das Fahrzeug folgt dabei der Scrollposition, also
    vorwärts beim Runterscrollen und zurück beim Hochscrollen.

    Bewusst über `position: sticky` gelöst und nicht über abgefangene
    Scroll-Ereignisse. Nur so bleiben Trackpad, Tastatur, Touch und die
    Scrollleiste unverändert bedienbar.
  */
  }
  <div data-process-pin>
    {
      /* Eigene, etwas knappere Polsterung: der ganze Block samt Foto
         muss beim Festhalten auch auf einem 720 px hohen Bildschirm
         vollstaendig sichtbar bleiben. */
    }
    <div class="py-16 md:pt-10 md:pb-14" data-process-sticky>
      <div class="container-page">
        <div
          class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-center md:gap-12"
        >
          <SectionHead
            id="ablauf-title"
            title="Von Ihrer Nachricht bis zum fertigen Gutachten"
            lead="Meist liegen zwischen dem ersten Foto und dem Gutachten bei der Versicherung nur wenige Tage. So läuft es ab."
          />
          <figure class="rounded-card overflow-hidden border border-white/10" data-reveal>
            <Image
              src={photo}
              alt={`${company.owner} fotografiert den Unfallschaden an einem Fahrzeug, auf dem Rücken das Logo von MK Stressfrei`}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1280px) 600px, (min-width: 768px) 46vw, 100vw"
              format="webp"
              quality={70}
              loading="lazy"
              decoding="async"
              class="aspect-[3/2] w-full object-cover md:aspect-[16/10] md:max-h-[min(22rem,30vh)] md:object-[50%_40%]"
            />
          </figure>
        </div>

        <div class="process mt-12 md:mt-14">
          {
            /* Fahrbahn von Punkt 1 bis Punkt 4, nur ab mittlerer Breite.
              Asphaltband mit Mittelstreifen, die gefahrene Strecke
              leuchtet in Kupfer nach. */
          }
          <div class="process-track" aria-hidden="true">
            <span class="process-road absolute inset-0 rounded-full"></span>
            <span
              class="process-fill absolute top-1/2 left-0 h-[3px] w-full origin-left -translate-y-1/2 rounded-full"
            ></span>

            <span class="process-runner absolute inset-y-0 left-0 block w-full">
              <span class="process-car absolute top-1/2 left-0 block -translate-y-1/2">
                <svg viewBox="0 0 240 64" width="96" height="26">
                  <defs>
                    <linearGradient id="pc-beam" x1="0" x2="1">
                      <stop offset="0" stop-color="#f7cba6" stop-opacity="0.75"></stop>
                      <stop offset="1" stop-color="#f7cba6" stop-opacity="0"></stop>
                    </linearGradient>
                    <linearGradient id="pc-body" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0" stop-color="#f7f8fc"></stop>
                      <stop offset="1" stop-color="#b8c3dc"></stop>
                    </linearGradient>
                  </defs>
                  <path d="M168 34 240 20v30z" fill="url(#pc-beam)"></path>
                  <ellipse cx="88" cy="56" rx="78" ry="6" fill="#000" opacity="0.45"></ellipse>
                  <path
                    d="M10 46V36q0-5 5-6.5l26-6 20-12.5q5-3 11-3h34q7 0 12 3.5l18 12 28 4.5q6 1 6 7V46q0 4-4 4H14q-4 0-4-4z"
                    fill="url(#pc-body)"></path>
                  <path d="M66 23 78 14h20v9zM104 14h16l14 9h-30z" fill="#14213d"></path>
                  <rect x="158" y="31" width="9" height="5" rx="2.5" fill="#fff4ea"></rect>
                  <rect x="10" y="32" width="5" height="5" rx="2" fill="#dd7d38"></rect>
                  <circle cx="46" cy="49" r="10" fill="#04070f"></circle>
                  <circle cx="46" cy="49" r="4" fill="#8494bc"></circle>
                  <circle cx="134" cy="49" r="10" fill="#04070f"></circle>
                  <circle cx="134" cy="49" r="4" fill="#8494bc"></circle>
                </svg>
              </span>
            </span>
          </div>

          <ol class="process-steps">
            {
              processSteps.map((step, i) => (
                <li class="relative flex gap-5 md:flex-col md:gap-0">
                  {i < processSteps.length - 1 && (
                    <span
                      class="bg-navy-700 absolute top-14 -bottom-9 left-6 w-px md:hidden"
                      aria-hidden="true"
                    />
                  )}

                  <span
                    class="process-dot bg-navy-850 font-display relative z-1 grid h-12 w-12 flex-none place-items-center rounded-full border text-[0.85rem] font-bold"
                    aria-hidden="true"
                  >
                    {step.n}
                  </span>

                  <div class="process-body md:mt-6">
                    <h3 class="text-bone-50 text-[1.08rem] font-bold">{step.title}</h3>
                    <p class="text-navy-300 mt-2 max-w-xs text-[0.92rem] leading-relaxed">
                      {step.text}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    --process-gap: 1.5rem;
    position: relative;
  }

  .process-steps {
    display: grid;
    gap: 2.25rem;
  }

  @media (min-width: 768px) {
    .process-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--process-gap);
    }
  }

  /*
    Die Fahrbahn endet exakt in der Mitte des vierten Punktes, damit das
    Fahrzeug dort stehen bleibt und nicht ins Leere weiterfährt.

    Bei vier gleichen Spalten liegt diese Mitte 25 % vom rechten Rand
    entfernt, abzüglich dreier Viertel der Spaltenlücke und des halben
    Punktdurchmessers.
  */
  .process-track {
    display: none;
    position: absolute;
    top: calc(1.5rem - 9px);
    left: 1.5rem;
    right: calc(25% - var(--process-gap) * 0.75 - 1.5rem);
    height: 18px;
    pointer-events: none;
  }

  .process-road {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.22) 0 14px, transparent 14px 30px)
        center / 100% 2px no-repeat,
      linear-gradient(180deg, #172440, #101a31);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      inset 0 -1px 0 rgb(0 0 0 / 0.4);
  }

  @media (min-width: 768px) {
    .process-track {
      display: block;
    }
  }

  /*
    Endzustand ist der Standard: Strecke gefüllt, alle Punkte hell, kein
    Fahrzeug. Ohne JavaScript, auf schmalen Displays und bei reduzierter
    Bewegung steht so eine fertige Grafik da statt einer leeren Linie.
  */
  .process-fill {
    transform: translateY(-50%) scaleX(1);
    background: linear-gradient(90deg, var(--color-copper-600), var(--color-copper-300));
    box-shadow: 0 0 12px 1px rgb(221 125 56 / 0.55);
  }

  .process-runner {
    display: none;
    will-change: transform;
  }

  .process-car {
    margin-left: -58px;
    filter: drop-shadow(0 0 10px rgb(247 203 166 / 0.25));
  }

  .process-dot {
    border-color: var(--color-copper-500);
    background-color: color-mix(in srgb, var(--color-copper-500) 14%, transparent);
    color: var(--color-copper-300);
    transition:
      border-color 260ms var(--ease-out-soft),
      background-color 260ms var(--ease-out-soft),
      color 260ms var(--ease-out-soft);
  }

  /* Erst wenn das Script übernimmt, wird auf Anfang gestellt. */
  [data-process-pin].is-armed .process-fill {
    transform: translateY(-50%) scaleX(0);
  }

  .process-body :is(h3, p) {
    transition: color 320ms var(--ease-out-soft);
  }

  /* Schritte, die das Auto noch nicht erreicht hat, treten zurueck.
     Ueber die Farbe statt ueber Deckkraft, damit der Kontrast auch im
     gedimmten Zustand fuer AA reicht. */
  [data-process-pin].is-armed li:has(.process-dot:not(.is-lit)) .process-body h3 {
    color: var(--color-navy-300);
  }

  [data-process-pin].is-armed li:has(.process-dot:not(.is-lit)) .process-body p {
    color: var(--color-navy-400);
  }

  [data-process-pin].is-armed .process-runner {
    display: block;
  }

  [data-process-pin].is-armed .process-dot {
    border-color: var(--color-navy-700);
    background-color: transparent;
    color: var(--color-navy-400);
  }

  [data-process-pin].is-armed .process-dot.is-lit {
    border-color: var(--color-copper-500);
    background-color: color-mix(in srgb, var(--color-copper-500) 14%, transparent);
    color: var(--color-copper-300);
  }

  /* Unter dem festen Header festhalten, nicht dahinter. */
  [data-process-pin].is-armed [data-process-sticky] {
    position: sticky;
    top: var(--header-h);
  }
</style>

<script>
  /**
   * Scrollgesteuerte Fahrt.
   *
   * Der Block wird über `position: sticky` festgehalten, während eine
   * zusätzliche Strecke unter ihm durchläuft. Aus deren Position ergibt
   * sich ein Fortschritt zwischen 0 und 1, den Fahrzeug, Fahrbahn und
   * Punkte übernehmen. Dadurch fährt das Auto beim Runterscrollen vor
   * und beim Hochscrollen zurück, ohne dass am Scrollverhalten selbst
   * etwas verändert wird.
   *
   * Aktiv nur ab mittlerer Breite: auf dem Handy stehen die Schritte
   * untereinander, eine waagerechte Fahrt ergäbe dort keinen Sinn.
   */
  const pin = document.querySelector<HTMLElement>('[data-process-pin]');
  const sticky = pin?.querySelector<HTMLElement>('[data-process-sticky]') ?? null;
  const fill = pin?.querySelector<HTMLElement>('.process-fill') ?? null;
  const runner = pin?.querySelector<HTMLElement>('.process-runner') ?? null;
  const dots = Array.from(pin?.querySelectorAll<HTMLElement>('.process-dot') ?? []);

  if (pin && sticky && fill && runner && dots.length > 1) {
    const wide = window.matchMedia('(min-width: 768px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const lastDot = dots.length - 1;

    let runway = 0;
    let ticking = false;

    const enabled = () => wide.matches && !reduce.matches;

    /** Zusätzliche Scrollstrecke, über die das Auto fährt. */
    const runwayFor = () => Math.round(Math.min(window.innerHeight * 0.85, 720));

    function apply(progress: number): void {
      runner!.style.transform = `translateX(${progress * 100}%)`;
      fill!.style.transform = `translateY(-50%) scaleX(${progress})`;

      dots.forEach((dot, i) => {
        // Punkt i sitzt bei i/3 der Fahrbahn. Die kleine Toleranz sorgt
        // dafür, dass der letzte Punkt am Ende sicher aufleuchtet.
        dot.classList.toggle('is-lit', progress >= i / lastDot - 0.005);
      });
    }

    function update(): void {
      ticking = false;
      if (!enabled() || runway <= 0) return;

      const offset = Number.parseFloat(getComputedStyle(sticky!).top) || 0;
      const raw = (offset - pin!.getBoundingClientRect().top) / runway;
      apply(Math.min(1, Math.max(0, raw)));
    }

    function layout(): void {
      if (!enabled()) {
        pin!.classList.remove('is-armed');
        pin!.style.height = '';
        runner!.style.transform = '';
        fill!.style.transform = '';
        for (const dot of dots) dot.classList.remove('is-lit');
        return;
      }

      pin!.classList.add('is-armed');
      runway = runwayFor();
      // Zusatzhöhe: genau so viel, wie das Auto zum Fahren braucht.
      pin!.style.height = `${sticky!.offsetHeight + runway}px`;
      update();
    }

    function onScroll(): void {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', layout, { passive: true });
    wide.addEventListener('change', layout);
    reduce.addEventListener('change', layout);

    layout();
  }
</script>
