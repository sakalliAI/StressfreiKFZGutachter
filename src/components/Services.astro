---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { services } from '../data/site';
import { serviceImages } from '../data/service-images';

/**
 * Leistungen auf der Startseite.
 *
 * Jede Karte fuehrt auf die eigene Seite der Leistung. Gross steht die
 * Lage in den Worten des Kunden, der Fachbegriff klein darunter. Mobil
 * eine kompakte Liste mit Vorschaubild statt Wischkarussell, so sieht
 * man alle sechs auf einen Blick.
 */
---

<section id="leistungen" class="section-pad bg-navy-900" aria-labelledby="leistungen-title">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHead
        id="leistungen-title"
        title="Was ist bei Ihnen passiert?"
        lead="Suchen Sie sich die Lage aus, die passt. Wie das Gutachten dazu heißt, steht klein darunter."
      />
      <a href="/leistungen/" class="btn btn-ghost hidden lg:inline-flex" data-reveal>
        Alle Leistungen
        <Icon name="arrow-right" size={17} />
      </a>
    </div>

    <ul class="mt-10 grid gap-3 sm:mt-12 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      {
        services.map((service, i) => {
          const cover = serviceImages[service.id];
          return (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
              <a
                href={`/leistungen/${service.slug}/`}
                class="svc-card group rounded-card bg-navy-850 hover:border-copper-500/50 relative grid h-full grid-cols-[4.75rem_minmax(0,1fr)_auto] items-center gap-4 overflow-hidden border border-white/8 p-2.5 pr-4 transition-colors sm:block sm:p-0"
              >
                {cover && (
                  <span class="relative block overflow-hidden rounded-lg sm:rounded-none">
                    <Image
                      src={cover}
                      alt={service.alt}
                      widths={[160, 420, 640, 900]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 4.75rem"
                      format="webp"
                      quality={66}
                      loading="lazy"
                      decoding="async"
                      class="aspect-square w-full object-cover saturate-[0.85] transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04] sm:aspect-[16/10]"
                    />
                    <span
                      class="absolute inset-0 hidden bg-[linear-gradient(to_top,var(--color-navy-850)_0%,transparent_55%)] sm:block"
                      aria-hidden="true"
                    />
                  </span>
                )}

                <span class="relative block sm:-mt-6 sm:px-6 sm:pb-6">
                  <span class="font-display text-bone-50 block text-[1.02rem] leading-snug font-bold sm:text-[1.3rem]">
                    {service.situation}
                  </span>
                  <span class="text-copper-400 mt-1 flex items-center gap-2 text-[0.85rem] font-semibold sm:mt-3">
                    {service.title}
                    <Icon
                      name="arrow-right"
                      size={15}
                      class="hidden transition-transform duration-300 group-hover:translate-x-1 sm:inline"
                    />
                  </span>
                  <span class="text-navy-300 mt-2.5 hidden text-[0.92rem] leading-relaxed sm:block">
                    {service.claim}
                  </span>
                </span>

                <Icon name="arrow-right" size={17} class="text-navy-400 sm:hidden" />
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="text-navy-300 mt-8 max-w-2xl text-[0.95rem] leading-relaxed" data-reveal>
      Nichts davon passt so richtig? Schicken Sie mir ein Foto per WhatsApp. Ich sage Ihnen, was
      sinnvoll ist, auch wenn das heißt: Sie brauchen gar kein Gutachten.
    </p>
  </div>
</section>
