---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { emergencySteps, company } from '../data/site';

/**
 * Was an der Unfallstelle zu tun ist.
 *
 * Gestaltet wie eine Karte aus dem Handschuhfach: hell, mit Warnstreifen,
 * Notrufnummern gross und als echte Links. Wer hier gerade mit zitternden
 * Haenden steht, soll nicht suchen muessen.
 */
---

<section id="sofort" class="section-pad bg-navy-850 relative" aria-labelledby="sofort-title">
  <div class="container-page">
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-center lg:gap-16"
    >
      <div>
        <SectionHead
          id="sofort-title"
          title="Gerade gekracht? Erst das, dann ich."
          lead="Vier Dinge an der Unfallstelle, in dieser Reihenfolge. Alles danach, Versicherung, Werkstatt, Papierkram, übernehme ich."
        />

        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap" data-reveal>
          <a href={company.phoneHref} class="btn btn-copper" data-track="call-sofort">
            <Icon name="phone" size={17} />
            {company.phoneDisplay}
          </a>
          <a
            href={company.whatsapp}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
            data-track="wa-sofort"
          >
            <Icon name="whatsapp" size={18} />
            Fotos schicken
          </a>
        </div>
      </div>

      <div class="notcard rounded-card relative overflow-hidden" data-reveal>
        <div class="hazard-bar h-3" aria-hidden="true"></div>

        {
          /* Notrufe zuerst und als Links, damit man direkt waehlen kann.
            112 und 110 getrennt, weil sie verschiedene Stellen erreichen. */
        }
        <div class="border-navy-900/10 grid grid-cols-2 border-b">
          <a
            href="tel:112"
            class="group hover:bg-navy-900/4 flex flex-col items-start gap-1.5 p-4 transition-colors sm:flex-row sm:items-center sm:gap-3 sm:p-5"
          >
            <span
              class="font-display text-[2.1rem] leading-none font-extrabold text-[#b4231a] tabular-nums sm:text-[2.5rem]"
              >112</span
            >
            <span class="text-navy-700 text-[0.85rem] leading-tight font-semibold">
              Verletzte?<br />Rettungsdienst
            </span>
          </a>
          <a
            href="tel:110"
            class="group border-navy-900/10 hover:bg-navy-900/4 flex flex-col items-start gap-1.5 border-l p-4 transition-colors sm:flex-row sm:items-center sm:gap-3 sm:p-5"
          >
            <span
              class="font-display text-navy-900 text-[2.1rem] leading-none font-extrabold tabular-nums sm:text-[2.5rem]"
              >110</span
            >
            <span class="text-navy-700 text-[0.85rem] leading-tight font-semibold">
              Streit, Flucht?<br />Polizei
            </span>
          </a>
        </div>

        <ol class="px-4 py-2 sm:px-6">
          {
            emergencySteps.map((step, i) => (
              <li
                class:list={[
                  'flex gap-4 py-4',
                  i > 0 && 'border-navy-900/15 border-t border-dashed',
                ]}
              >
                <span
                  class="font-display border-navy-900/70 text-navy-900 grid h-8 w-8 flex-none place-items-center rounded-full border-2 text-[0.9rem] font-extrabold"
                  aria-hidden="true"
                >
                  {step.n}
                </span>
                <div>
                  <h3 class="text-navy-900 text-[1.02rem] font-bold">{step.title}</h3>
                  <p class="text-navy-600 mt-1 text-[0.92rem] leading-relaxed">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .notcard {
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(255 255 255 / 0.7), transparent 60%),
      var(--color-bone-50);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 30px 60px -25px rgb(0 0 0 / 0.65),
      0 0 0 1px rgb(255 255 255 / 0.08);
  }

  @media (min-width: 1024px) {
    .notcard {
      transform: rotate(0.6deg);
    }
  }

  /* Warnstreifen wie auf einer Absperrbake. */
  .hazard-bar {
    background-image: repeating-linear-gradient(
      -45deg,
      var(--color-copper-500) 0 14px,
      var(--color-navy-900) 14px 28px
    );
  }
</style>
