---
import Icon from './Icon.astro';
import { company, damageTypes, reachableSlots, upload } from '../data/site';

// Turnstile ist optional. Ist kein Site-Key gesetzt, greifen weiterhin
// Honeypot, Zeitprüfung und Rate-Limit in der Pages Function.
const turnstileSiteKey = import.meta.env['PUBLIC_TURNSTILE_SITE_KEY'] ?? '';

const field =
  'w-full rounded-lg border border-white/12 bg-navy-900 px-4 py-3 text-[0.95rem] text-bone-50 placeholder:text-navy-500 transition-colors duration-200 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/35';
const label = 'block text-[0.82rem] font-semibold text-navy-300';
---

<section id="kontakt" class="section-pad bg-navy-900">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
      <!-- Direkte Wege zuerst. Wer gerade an der Unfallstelle steht,
           tippt kein Formular aus. -->
      <div>
        <p class="eyebrow" data-reveal>Kontakt</p>
        <h2
          class="text-bone-50 mt-4 text-[clamp(1.75rem,3.4vw+0.6rem,2.6rem)] font-bold"
          data-reveal
        >
          Schildern Sie mir kurz, was passiert ist.
        </h2>
        <p class="text-navy-300 mt-4 max-w-md text-[1rem] leading-relaxed" data-reveal>
          Am schnellsten geht ein Anruf oder eine WhatsApp mit Foto. Wenn es Ihnen lieber ist,
          nehmen Sie das Formular.
        </p>

        <div class="mt-8 grid gap-2.5" data-reveal>
          <a
            href={company.whatsapp}
            target="_blank"
            rel="noopener"
            class="btn btn-wa w-full sm:w-auto"
            data-track="wa-kontakt"
          >
            <Icon name="whatsapp" size={18} />
            WhatsApp an {company.phoneDisplay}
          </a>
          <a
            href={company.phoneHref}
            class="btn btn-ghost w-full sm:w-auto"
            data-track="call-kontakt"
          >
            <Icon name="phone" size={17} />
            Anrufen
          </a>
        </div>

        {
          /*
          Bewusst eine Liste statt <dl>. Ein <dl> erlaubt zwischen sich
          und den <dt>/<dd> hoechstens eine <div>-Ebene. Das Icon
          daneben braucht aber eine eigene Ebene, wodurch die Struktur
          ungueltig wuerde.
        */
        }
        <ul class="mt-10 grid gap-5 border-t border-white/8 pt-8 text-[0.9rem]" data-reveal>
          <li class="flex gap-3">
            <Icon name="clock" size={17} class="text-gold-400 mt-0.5 flex-none" />
            <div>
              <p class="text-bone-50 font-semibold">Erreichbarkeit</p>
              <p class="text-navy-400 mt-1 leading-relaxed">{company.hours}</p>
            </div>
          </li>
          <li class="flex gap-3">
            <Icon name="map-pin" size={17} class="text-gold-400 mt-0.5 flex-none" />
            <div>
              <p class="text-bone-50 font-semibold">Besichtigung</p>
              <p class="text-navy-400 mt-1 leading-relaxed">
                Vor Ort bei Ihnen{company.region ? ` in ${company.region}` : ''}. Werkstatt,
                Zuhause, Abstellplatz oder Unfallstelle.
              </p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Formular -->
      <div class="rounded-card bg-navy-850 border border-white/10 p-5 sm:p-8" data-reveal>
        <form id="contact-form" class="grid gap-5" novalidate>
          <!--
            Erste Frage in der Sprache des Kunden, nicht in der des
            Gutachters. Wer gerade einen Schaden hat, weiss ob ihm jemand
            reingefahren ist. Ob das ein "Haftpflichtschaden" heisst,
            weiss er nicht.
          -->
          <div>
            <label class={label} for="cf-kind">Was ist passiert?</label>
            <select id="cf-kind" name="kind" class={`${field} mt-2`}>
              <option value="">Bitte auswählen</option>
              {damageTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class={label} for="cf-name">Name <span aria-hidden="true">*</span></label>
              <input
                id="cf-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                maxlength="80"
                class={`${field} mt-2`}
                placeholder="Vor- und Nachname"
              />
            </div>
            <div>
              <label class={label} for="cf-phone">Telefon <span aria-hidden="true">*</span></label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                maxlength="40"
                class={`${field} mt-2`}
                placeholder="Für den Rückruf"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class={label} for="cf-email">E-Mail</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="120"
                class={`${field} mt-2`}
                placeholder="Optional"
              />
            </div>
            <div>
              <label class={label} for="cf-plate">Kennzeichen</label>
              <input
                id="cf-plate"
                name="plate"
                type="text"
                maxlength="20"
                class={`${field} mt-2`}
                placeholder="Optional"
              />
            </div>
          </div>

          <div>
            <label class={label} for="cf-message">
              Was ist passiert? <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="cf-message"
              name="message"
              required
              rows="4"
              maxlength="2000"
              class={`${field} mt-2 resize-y`}
              placeholder="Ein, zwei Sätze reichen. Wann, wo, wer war beteiligt."></textarea>
          </div>

          <!--
            Foto-Upload. Der wichtigste Zusatz am Formular: an mehreren
            Stellen der Seite steht "ein Foto vom Schaden reicht für den
            Anfang", und bis hierher konnte das Formular genau das nicht
            annehmen.

            Die Bilder werden im Browser verkleinert, bevor sie gesendet
            werden. Ein Handyfoto hat leicht 5 MB, verkleinert sind es
            etwa 300 KB. Das hält den Versand auch bei schlechter
            Verbindung am Straßenrand in einem Rahmen, der durchgeht.
          -->
          <div>
            <label class={label} for="cf-photos">Fotos vom Schaden</label>
            <input
              id="cf-photos"
              name="photos"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/heic"
              multiple
              class={`${field} mt-2 file:mr-3 file:rounded-md file:border-0 file:bg-white/10 file:px-3 file:py-1.5 file:text-[0.85rem] file:font-semibold file:text-bone-100`}
            />
            <p class="text-navy-400 mt-2 text-[0.8rem] leading-relaxed" data-upload-hint>
              Optional, bis zu {upload.maxFiles} Bilder. Ein Foto vom Schaden reicht oft schon, um Ihnen
              zu sagen, woran Sie sind.
            </p>
          </div>

          <div>
            <label class={label} for="cf-reach">Wann erreiche ich Sie am besten?</label>
            <select id="cf-reach" name="reach" class={`${field} mt-2`}>
              <option value="">Bitte auswählen</option>
              {reachableSlots.map((slot) => <option value={slot}>{slot}</option>)}
            </select>
          </div>

          <!-- Honeypot. Für Menschen unsichtbar, aber nicht per
               display:none, weil manche Bots das erkennen. -->
          <div class="absolute left-[-9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
            <label for="cf-website">Website</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" id="cf-ts" value="0" />

          {
            turnstileSiteKey && (
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="dark"
                data-language="de"
              />
            )
          }

          <label
            class="text-navy-400 flex cursor-pointer items-start gap-3 text-[0.84rem] leading-relaxed"
          >
            <input
              type="checkbox"
              name="privacy"
              required
              class="bg-navy-900 accent-gold-500 mt-0.5 h-5 w-5 flex-none rounded border-white/25"
            />
            <span>
              Ich habe die
              <button
                type="button"
                class="text-gold-400 font-semibold underline underline-offset-2"
                data-legal-open="datenschutz"
              >
                Datenschutzerklärung
              </button>
              gelesen und bin damit einverstanden, dass meine Angaben und mitgeschickten Fotos zur Bearbeitung
              meiner Anfrage verarbeitet werden. <span aria-hidden="true">*</span>
            </span>
          </label>

          <button type="submit" class="btn btn-gold w-full" data-track="form-submit">
            <span data-submit-label>Anfrage senden</span>
            <Icon name="arrow-right" size={17} />
          </button>

          <!-- aria-live, damit Screenreader die Rückmeldung mitbekommen -->
          <p
            id="cf-status"
            role="status"
            aria-live="polite"
            class="hidden rounded-lg px-4 py-3 text-[0.88rem] leading-relaxed"
          >
          </p>

          <noscript>
            <p
              class="bg-gold-500/12 text-bone-100 rounded-lg px-4 py-3 text-[0.86rem] leading-relaxed"
            >
              Für das Formular wird JavaScript benötigt. Rufen Sie einfach an unter
              {company.phoneDisplay} oder schreiben Sie an {company.email}.
            </p>
          </noscript>
        </form>
      </div>
    </div>
  </div>
</section>

{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  import { upload } from '../data/site';

  const form = document.getElementById('contact-form');
  const status = document.getElementById('cf-status');
  const ts = document.getElementById('cf-ts');
  const photos = document.getElementById('cf-photos');
  const hint = document.querySelector<HTMLElement>('[data-upload-hint]');
  const hintDefault = hint?.textContent ?? '';

  // Zeitstempel des Seitenaufrufs. Die Function verwirft Einsendungen,
  // die unrealistisch schnell ankommen.
  if (ts instanceof HTMLInputElement) ts.value = String(Date.now());

  function show(kind: 'ok' | 'error', text: string): void {
    if (!status) return;
    status.textContent = text;
    status.className =
      kind === 'ok'
        ? 'rounded-lg bg-wa-500/14 px-4 py-3 text-[0.88rem] leading-relaxed text-wa-500'
        : 'rounded-lg bg-gold-500/14 px-4 py-3 text-[0.88rem] leading-relaxed text-gold-300';
  }

  /**
   * Verkleinert ein Bild im Browser und gibt es als JPEG in Base64 zurück.
   *
   * `createImageBitmap` dreht das Bild anhand der EXIF-Angabe richtig
   * herum. Ohne `imageOrientation` liegen Hochformataufnahmen vom iPhone
   * beim Empfänger auf der Seite.
   */
  async function shrink(file: File): Promise<{ name: string; content: string } | null> {
    let bitmap: ImageBitmap;
    try {
      bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
    } catch {
      return null;
    }

    const scale = Math.min(1, upload.maxEdge / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);

    const context = canvas.getContext('2d');
    if (!context) return null;
    context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();

    // Bei sehr detailreichen Aufnahmen notfalls ein zweites Mal
    // herunterdrehen, damit die Obergrenze sicher eingehalten wird.
    for (const quality of [0.72, 0.58, 0.45]) {
      const dataUrl = canvas.toDataURL('image/jpeg', quality);
      const content = dataUrl.slice(dataUrl.indexOf(',') + 1);
      if (content.length * 0.75 <= upload.maxBytes) {
        const base = file.name.replace(/\.[^.]+$/, '').slice(0, 40) || 'foto';
        return { name: `${base}.jpg`, content };
      }
    }

    return null;
  }

  photos?.addEventListener('change', () => {
    if (!(photos instanceof HTMLInputElement) || !hint) return;
    const count = photos.files?.length ?? 0;
    hint.textContent =
      count > upload.maxFiles
        ? `Es werden die ersten ${upload.maxFiles} Bilder gesendet.`
        : count > 0
          ? `${count} ${count === 1 ? 'Bild' : 'Bilder'} ausgewählt. Wird vor dem Senden verkleinert.`
          : hintDefault;
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    if (!form.reportValidity()) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const original = buttonLabel?.textContent ?? 'Anfrage senden';

    if (button) button.disabled = true;
    if (buttonLabel) buttonLabel.textContent = 'Wird gesendet …';

    try {
      const data = new FormData(form);
      // Die Dateien gehen getrennt als verkleinertes Base64 mit, nicht
      // als Teil der Felder.
      data.delete('photos');
      const payload: Record<string, unknown> = Object.fromEntries(data.entries());

      const files = Array.from(
        photos instanceof HTMLInputElement ? (photos.files ?? []) : [],
      ).slice(0, upload.maxFiles);

      if (files.length > 0) {
        if (buttonLabel) buttonLabel.textContent = 'Fotos werden vorbereitet …';
        const prepared = await Promise.all(files.map(shrink));
        const usable = prepared.filter((item) => item !== null);
        if (usable.length > 0) payload['attachments'] = usable;
        if (usable.length < files.length) {
          show('error', 'Mindestens ein Bild ließ sich nicht verarbeiten und wurde weggelassen.');
        }
        if (buttonLabel) buttonLabel.textContent = 'Wird gesendet …';
      }

      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result: unknown = await response.json().catch(() => ({}));
      const message =
        typeof result === 'object' && result !== null && 'message' in result
          ? String((result as { message: unknown }).message)
          : '';

      if (response.ok) {
        show('ok', message || 'Angekommen. Ich melde mich zeitnah bei Ihnen.');
        form.reset();
        if (hint) hint.textContent = hintDefault;
        if (ts instanceof HTMLInputElement) ts.value = String(Date.now());
      } else {
        show(
          'error',
          message ||
            'Das hat gerade nicht geklappt. Rufen Sie mich bitte direkt an, dann geht es schneller.',
        );
      }
    } catch {
      show(
        'error',
        'Keine Verbindung zum Server. Bitte rufen Sie an oder schreiben Sie per WhatsApp.',
      );
    } finally {
      if (button) button.disabled = false;
      if (buttonLabel) buttonLabel.textContent = original;
    }
  });
</script>
