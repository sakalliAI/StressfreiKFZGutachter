---
import Icon from './Icon.astro';
import { company, damageTypes, reachableSlots, upload } from '../data/site';

// Turnstile ist optional. Ist kein Site-Key gesetzt, greifen weiterhin
// Honeypot, Zeitprüfung und Rate-Limit in der Pages Function.
const turnstileSiteKey = import.meta.env['PUBLIC_TURNSTILE_SITE_KEY'] ?? '';

const field =
  'w-full rounded-lg border border-white/12 bg-navy-900 px-4 py-3 text-[0.95rem] text-bone-50 placeholder:text-navy-500 transition-colors duration-200 focus:border-copper-500 focus:outline-none focus:ring-2 focus:ring-copper-500/35';
const label = 'block text-[0.82rem] font-semibold text-navy-300';
---

<section id="kontakt" class="section-pad bg-navy-900" aria-labelledby="kontakt-title" data-cta-zone>
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
      {
        /* Direkte Wege zuerst. Wer gerade an der Unfallstelle steht,
          tippt kein Formular aus. */
      }
      <div>
        <h2
          id="kontakt-title"
          class="text-bone-50 text-[clamp(1.9rem,3vw+0.8rem,3rem)] font-bold"
          data-reveal
        >
          Schildern Sie mir kurz, was passiert ist.
        </h2>
        <p class="text-navy-300 mt-4 max-w-md text-[1rem] leading-relaxed" data-reveal>
          Am schnellsten geht ein Anruf oder eine WhatsApp mit Foto. Wenn es Ihnen lieber ist,
          nehmen Sie das Formular.
        </p>

        <div class="mt-8 grid gap-2.5" data-reveal>
          <a
            href={company.whatsapp}
            target="_blank"
            rel="noopener"
            class="btn btn-wa w-full sm:w-auto"
            data-track="wa-kontakt"
          >
            <Icon name="whatsapp" size={18} />
            WhatsApp an {company.phoneDisplay}
          </a>
          <a
            href={company.phoneHref}
            class="btn btn-ghost w-full sm:w-auto"
            data-track="call-kontakt"
          >
            <Icon name="phone" size={17} />
            Anrufen
          </a>
        </div>

        {
          /*
          Bewusst eine Liste statt <dl>. Ein <dl> erlaubt zwischen sich
          und den <dt>/<dd> hoechstens eine <div>-Ebene. Das Icon
          daneben braucht aber eine eigene Ebene, wodurch die Struktur
          ungueltig wuerde.
        */
        }
        <ul class="mt-10 grid gap-5 border-t border-white/8 pt-8 text-[0.9rem]" data-reveal>
          <li class="flex gap-3">
            <Icon name="clock" size={17} class="text-copper-400 mt-0.5 flex-none" />
            <div>
              <p class="text-bone-50 font-semibold">Erreichbarkeit</p>
              <p class="text-navy-400 mt-1 leading-relaxed">{company.hours}</p>
            </div>
          </li>
          <li class="flex gap-3">
            <Icon name="mail" size={17} class="text-copper-400 mt-0.5 flex-none" />
            <div>
              <p class="text-bone-50 font-semibold">E-Mail</p>
              <a
                href={`mailto:${company.email}`}
                class="text-navy-300 hover:text-copper-400 mt-1 inline-block underline decoration-white/20 underline-offset-4"
                >{company.email}</a
              >
            </div>
          </li>
          <li class="flex gap-3">
            <Icon name="map-pin" size={17} class="text-copper-400 mt-0.5 flex-none" />
            <div>
              <p class="text-bone-50 font-semibold">Büro</p>
              <p class="text-navy-400 mt-1 leading-relaxed">
                {`${company.street}, ${company.zip} ${company.city}`}
              </p>
            </div>
          </li>
          <li class="flex gap-3">
            <Icon name="car" size={17} class="text-copper-400 mt-0.5 flex-none" />
            <div>
              <p class="text-bone-50 font-semibold">Besichtigung</p>
              <p class="text-navy-400 mt-1 leading-relaxed">
                Vor Ort bei Ihnen{company.region ? ` in ${company.region}` : ''}. Werkstatt,
                Zuhause, Abstellplatz oder Unfallstelle.
              </p>
            </div>
          </li>
        </ul>
      </div>

      <div class="rounded-card bg-navy-850 border border-white/10 p-5 sm:p-8" data-reveal>
        <form id="contact-form" class="grid gap-5" novalidate>
          {
            /* Erste Frage in der Sprache des Kunden, nicht in der des
              Gutachters. */
          }
          <div>
            <label class={label} for="cf-kind">Worum geht es?</label>
            <select id="cf-kind" name="kind" class={`${field} mt-2`}>
              <option value="">Bitte auswählen</option>
              {damageTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class={label} for="cf-name">Name <span aria-hidden="true">*</span></label>
              <input
                id="cf-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                maxlength="80"
                class={`${field} mt-2`}
                placeholder="Vor- und Nachname"
              />
            </div>
            <div>
              <label class={label} for="cf-phone">Telefon <span aria-hidden="true">*</span></label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                maxlength="40"
                class={`${field} mt-2`}
                placeholder="Für den Rückruf"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class={label} for="cf-email">E-Mail</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="120"
                class={`${field} mt-2`}
                placeholder="Optional"
              />
            </div>
            <div>
              <label class={label} for="cf-plate">Kennzeichen</label>
              <input
                id="cf-plate"
                name="plate"
                type="text"
                maxlength="20"
                class={`${field} mt-2`}
                placeholder="Optional"
              />
            </div>
          </div>

          <div>
            <label class={label} for="cf-message">
              Kurz beschrieben <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="cf-message"
              name="message"
              required
              rows="4"
              maxlength="2000"
              class={`${field} mt-2 resize-y`}
              placeholder="Ein, zwei Sätze reichen. Wann, wo, wer war beteiligt."></textarea>
          </div>

          {
            /* Foto-Upload. An mehreren Stellen steht "ein Foto reicht fuer
              den Anfang", also muss das Formular genau das koennen. Die
              Bilder werden im Browser verkleinert (5 MB Handyfoto werden
              etwa 300 KB), damit der Versand auch am Strassenrand mit
              schwachem Netz durchgeht. Das native Dateifeld liegt
              unsichtbar ueber der Ablageflaeche, so bleibt es per Tastatur
              und Screenreader bedienbar und spricht trotzdem Deutsch. */
          }
          <div>
            <p class={label} id="cf-photos-label">Fotos vom Schaden</p>
            <div
              class="upload-zone group hover:border-copper-500/60 bg-navy-900 relative mt-2 flex items-center gap-4 rounded-lg border border-dashed border-white/20 px-4 py-4 transition-colors"
              data-upload-zone
            >
              <span
                class="bg-copper-500/12 text-copper-400 grid h-11 w-11 flex-none place-items-center rounded-full"
                aria-hidden="true"
              >
                <Icon name="camera" size={20} />
              </span>
              <span class="text-[0.9rem] leading-snug">
                <span class="text-bone-50 block font-semibold">Fotos auswählen</span>
                <span class="text-navy-400 block text-[0.8rem]">
                  oder hierher ziehen. Bis zu {upload.maxFiles} Bilder.
                </span>
              </span>
              <input
                id="cf-photos"
                name="photos"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/heic"
                multiple
                aria-labelledby="cf-photos-label"
                aria-describedby="cf-photos-hint"
                class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
              />
            </div>
            <ul
              class="mt-3 hidden flex-wrap gap-2.5"
              data-upload-list
              aria-label="Ausgewählte Fotos"
            >
            </ul>
            <p
              id="cf-photos-hint"
              class="text-navy-400 mt-2 text-[0.8rem] leading-relaxed"
              data-upload-hint
            >
              Optional. Oft kann ich schon am Foto sagen, woran Sie sind.
            </p>
          </div>

          <div>
            <label class={label} for="cf-reach">Wann erreiche ich Sie am besten?</label>
            <select id="cf-reach" name="reach" class={`${field} mt-2`}>
              <option value="">Bitte auswählen</option>
              {reachableSlots.map((slot) => <option value={slot}>{slot}</option>)}
            </select>
          </div>

          {
            /* Honeypot. Für Menschen unsichtbar, aber nicht per
              display:none, weil manche Bots das erkennen. */
          }
          <div class="absolute left-[-9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
            <label for="cf-website">Website</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" id="cf-ts" value="0" />

          {
            turnstileSiteKey && (
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="dark"
                data-language="de"
              />
            )
          }

          <label
            class="text-navy-400 flex cursor-pointer items-start gap-3 text-[0.84rem] leading-relaxed"
          >
            <input
              type="checkbox"
              name="privacy"
              required
              class="bg-navy-900 accent-copper-500 mt-0.5 h-5 w-5 flex-none rounded border-white/25"
            />
            {
              /* Neuer Tab, damit niemand sein halb ausgefuelltes Formular
                verliert. Die Leerzeichen um den Link stehen ausdruecklich
                drin, sonst zieht Astro sie zusammen. */
            }
            <span>
              Ich habe die{' '}
              <a
                href="/datenschutz/"
                target="_blank"
                rel="noopener"
                class="text-copper-400 font-semibold underline underline-offset-2"
              >
                Datenschutzerklärung
              </a>{' '}
              zur Kenntnis genommen. Meine Angaben und Fotos werden nur zur Bearbeitung meiner Anfrage
              verwendet. <span aria-hidden="true">*</span>
            </span>
          </label>

          <button type="submit" class="btn btn-copper w-full" data-track="form-submit">
            <span data-submit-label>Anfrage senden</span>
            <Icon name="arrow-right" size={17} />
          </button>

          {/* aria-live, damit Screenreader die Rückmeldung mitbekommen */}
          <p
            id="cf-status"
            role="status"
            aria-live="polite"
            class="hidden rounded-lg px-4 py-3 text-[0.88rem] leading-relaxed"
          >
          </p>

          <noscript>
            <p
              class="bg-copper-500/12 text-bone-100 rounded-lg px-4 py-3 text-[0.86rem] leading-relaxed"
            >
              {
                `Für das Formular wird JavaScript benötigt. Rufen Sie einfach an unter ${company.phoneDisplay} oder schreiben Sie an ${company.email}.`
              }
            </p>
          </noscript>
        </form>
      </div>
    </div>
  </div>
</section>

{
  turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  import { upload } from '../data/site';

  const form = document.getElementById('contact-form');
  const status = document.getElementById('cf-status');
  const ts = document.getElementById('cf-ts');
  const photos = document.getElementById('cf-photos');
  const hint = document.querySelector<HTMLElement>('[data-upload-hint]');
  const hintDefault = hint?.textContent ?? '';
  const zone = document.querySelector<HTMLElement>('[data-upload-zone]');
  const list = document.querySelector<HTMLUListElement>('[data-upload-list]');

  /** Ausgewaehlte Bilder. Eigene Liste statt input.files, damit man
   *  nachlegen und einzelne Bilder wieder entfernen kann. */
  let selected: File[] = [];

  // Zeitstempel des Seitenaufrufs. Die Function verwirft Einsendungen,
  // die unrealistisch schnell ankommen.
  if (ts instanceof HTMLInputElement) ts.value = String(Date.now());

  function show(kind: 'ok' | 'error', text: string): void {
    if (!status) return;
    status.textContent = text;
    status.className =
      kind === 'ok'
        ? 'rounded-lg bg-wa-500/14 px-4 py-3 text-[0.88rem] leading-relaxed text-wa-500'
        : 'rounded-lg bg-copper-500/14 px-4 py-3 text-[0.88rem] leading-relaxed text-copper-300';
  }

  /**
   * Verkleinert ein Bild im Browser und gibt es als JPEG in Base64 zurück.
   *
   * `createImageBitmap` dreht das Bild anhand der EXIF-Angabe richtig
   * herum. Ohne `imageOrientation` liegen Hochformataufnahmen vom iPhone
   * beim Empfänger auf der Seite.
   */
  async function shrink(file: File): Promise<{ name: string; content: string } | null> {
    let bitmap: ImageBitmap;
    try {
      bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
    } catch {
      return null;
    }

    const scale = Math.min(1, upload.maxEdge / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);

    const context = canvas.getContext('2d');
    if (!context) return null;
    context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    bitmap.close();

    // Bei sehr detailreichen Aufnahmen notfalls ein zweites Mal
    // herunterdrehen, damit die Obergrenze sicher eingehalten wird.
    for (const quality of [0.72, 0.58, 0.45]) {
      const dataUrl = canvas.toDataURL('image/jpeg', quality);
      const content = dataUrl.slice(dataUrl.indexOf(',') + 1);
      if (content.length * 0.75 <= upload.maxBytes) {
        const base = file.name.replace(/\.[^.]+$/, '').slice(0, 40) || 'foto';
        return { name: `${base}.jpg`, content };
      }
    }

    return null;
  }

  function renderSelection(): void {
    if (!list || !hint) return;
    for (const img of list.querySelectorAll('img')) URL.revokeObjectURL(img.src);
    list.replaceChildren();
    list.classList.toggle('hidden', selected.length === 0);
    list.classList.toggle('flex', selected.length > 0);

    selected.forEach((file, index) => {
      const item = document.createElement('li');
      item.className =
        'relative h-20 w-20 overflow-hidden rounded-lg border border-white/12 bg-navy-800';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.alt = file.name;
      img.className = 'h-full w-full object-cover';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className =
        'absolute top-1 right-1 grid h-7 w-7 place-items-center rounded-full bg-navy-950/85 text-bone-50 text-base leading-none hover:bg-copper-600';
      remove.setAttribute('aria-label', `${file.name} entfernen`);
      remove.textContent = '\u00d7';
      remove.addEventListener('click', () => {
        selected.splice(index, 1);
        renderSelection();
        photos?.focus();
      });
      item.append(img, remove);
      list.append(item);
    });

    hint.textContent =
      selected.length > 0
        ? `${selected.length} von ${upload.maxFiles} Bildern ausgewählt. Sie werden vor dem Senden verkleinert.`
        : hintDefault;
  }

  function addFiles(files: Iterable<File>): void {
    const images = Array.from(files).filter(
      (file) => file.type.startsWith('image/') || /\.heic$/i.test(file.name),
    );
    const room = upload.maxFiles - selected.length;
    selected = selected.concat(images.slice(0, Math.max(0, room)));
    renderSelection();
    if (images.length > room && hint) {
      hint.textContent = `Es gehen höchstens ${upload.maxFiles} Bilder mit. Die übrigen wurden nicht übernommen.`;
    }
  }

  photos?.addEventListener('change', () => {
    if (!(photos instanceof HTMLInputElement)) return;
    addFiles(photos.files ?? []);
    // Zuruecksetzen, damit dasselbe Bild nach dem Entfernen wieder
    // gewaehlt werden kann.
    photos.value = '';
  });

  // Ziehen und Ablegen. Das unsichtbare Dateifeld liegt ueber der Flaeche
  // und nimmt den Drop selbst an, hier nur der sichtbare Zustand.
  for (const type of ['dragenter', 'dragover'] as const) {
    zone?.addEventListener(type, () => zone.classList.add('is-drag'));
  }
  for (const type of ['dragleave', 'drop'] as const) {
    zone?.addEventListener(type, () => zone.classList.remove('is-drag'));
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    if (!form.reportValidity()) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const original = buttonLabel?.textContent ?? 'Anfrage senden';

    if (button) button.disabled = true;
    if (buttonLabel) buttonLabel.textContent = 'Wird gesendet …';

    try {
      const data = new FormData(form);
      // Die Dateien gehen getrennt als verkleinertes Base64 mit, nicht
      // als Teil der Felder.
      data.delete('photos');
      const payload: Record<string, unknown> = Object.fromEntries(data.entries());

      const files = selected.slice(0, upload.maxFiles);

      if (files.length > 0) {
        if (buttonLabel) buttonLabel.textContent = 'Fotos werden vorbereitet …';
        const prepared = await Promise.all(files.map(shrink));
        const usable = prepared.filter((item) => item !== null);
        if (usable.length > 0) payload['attachments'] = usable;
        if (usable.length < files.length) {
          show('error', 'Mindestens ein Bild ließ sich nicht verarbeiten und wurde weggelassen.');
        }
        if (buttonLabel) buttonLabel.textContent = 'Wird gesendet …';
      }

      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result: unknown = await response.json().catch(() => ({}));
      const message =
        typeof result === 'object' && result !== null && 'message' in result
          ? String((result as { message: unknown }).message)
          : '';

      if (response.ok) {
        show('ok', message || 'Angekommen. Ich melde mich zeitnah bei Ihnen.');
        form.reset();
        selected = [];
        renderSelection();
        if (ts instanceof HTMLInputElement) ts.value = String(Date.now());
      } else {
        show(
          'error',
          message ||
            'Das hat gerade nicht geklappt. Rufen Sie mich bitte direkt an, dann geht es schneller.',
        );
      }
    } catch {
      show(
        'error',
        'Keine Verbindung zum Server. Bitte rufen Sie an oder schreiben Sie per WhatsApp.',
      );
    } finally {
      if (button) button.disabled = false;
      if (buttonLabel) buttonLabel.textContent = original;
    }
  });
</script>

<style>
  .upload-zone:focus-within {
    border-color: var(--color-copper-500);
    box-shadow: 0 0 0 3px rgb(221 125 56 / 0.35);
  }

  .upload-zone.is-drag {
    border-color: var(--color-copper-400);
    background-color: rgb(221 125 56 / 0.08);
  }
</style>
