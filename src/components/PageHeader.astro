---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Crumb } from '../layouts/Layout.astro';

/**
 * Kopf einer Unterseite: Brotkrumen, Ueberschrift, Einleitung, optional
 * ein Bild rechts.
 *
 * Bewusst ohne Ueberzeile und ohne Zierlinie. Die Brotkrumen sagen
 * bereits, wo man ist; eine zusaetzliche Kategoriezeile darueber waere
 * dieselbe Information ein zweites Mal.
 *
 * Das Bild laedt sofort und mit hoher Prioritaet: auf Leistungsseiten
 * ist es das groesste Element im ersten Bildschirm und damit das LCP.
 */
interface Props {
  title: string;
  lead?: string | undefined;
  breadcrumbs: readonly Crumb[];
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
}

const { title, lead, breadcrumbs, image, imageAlt = '' } = Astro.props;
const trail = [{ name: 'Startseite', path: '/' }, ...breadcrumbs];
---

<header
  id="top"
  class="bg-navy-950 relative overflow-hidden pt-[calc(var(--header-h)+2rem)] pb-12 md:pt-[calc(var(--header-h)+3rem)] md:pb-16"
  data-cta-zone
>
  <div
    class="pointer-events-none absolute -top-40 right-[-10%] h-[28rem] w-[38rem] rounded-full bg-[radial-gradient(closest-side,rgb(221_125_56/0.16),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div
    class:list={[
      'container-page relative',
      image && 'grid items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14',
    ]}
  >
    <div>
      <nav aria-label="Brotkrumen">
        <ol class="text-navy-400 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.82rem]">
          {
            trail.map((crumb, i) => {
              const last = i === trail.length - 1;
              return (
                <li class="flex items-center gap-2">
                  {last ? (
                    <span aria-current="page" class="text-navy-300">
                      {crumb.name}
                    </span>
                  ) : (
                    <>
                      <a href={crumb.path} class="hover:text-copper-400 transition-colors">
                        {crumb.name}
                      </a>
                      <span aria-hidden="true" class="text-navy-600">
                        /
                      </span>
                    </>
                  )}
                </li>
              );
            })
          }
        </ol>
      </nav>

      <h1 class="text-bone-50 mt-5 max-w-4xl text-[clamp(2rem,3.8vw+0.6rem,3.4rem)] font-extrabold">
        {title}
      </h1>

      {
        lead && (
          <p class="text-bone-200 mt-5 max-w-2xl text-[1.05rem] leading-relaxed md:text-[1.12rem]">
            {lead}
          </p>
        )
      }

      <slot />
    </div>

    {
      image && (
        <div class="rounded-card relative aspect-[4/3] overflow-hidden border border-white/10 shadow-[0_30px_80px_-40px_rgb(0_0_0/0.9)]">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            format="webp"
            quality={70}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <span
            class="absolute inset-0 bg-[linear-gradient(to_top,rgb(4_7_15/0.45),transparent_55%)]"
            aria-hidden="true"
          />
        </div>
      )
    }
  </div>
</header>
