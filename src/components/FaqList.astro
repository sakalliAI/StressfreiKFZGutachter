---
import Icon from './Icon.astro';

/**
 * Fragen und Antworten als aufklappbare Liste.
 *
 * <details> statt eigenem Akkordeon: funktioniert ohne JavaScript, ist
 * tastaturbedienbar, und der Text steht im Markup, also fuer Crawler und
 * Sprachmodelle lesbar. Die gleichen Fragen gehen als FAQPage ins Schema,
 * das macht die jeweilige Seite selbst.
 */
interface Props {
  items: readonly { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-white/8 border-y border-white/8" data-faq-group>
  {
    items.map((item) => (
      <details class="faq group">
        <summary class="text-bone-50 hover:text-copper-400 flex cursor-pointer list-none items-start justify-between gap-5 py-5 text-[1rem] font-semibold transition-colors">
          {item.q}
          <span
            class="text-navy-300 group-open:border-copper-500 group-open:text-copper-400 mt-0.5 grid h-7 w-7 flex-none place-items-center rounded-full border border-white/15 transition-transform duration-300 group-open:rotate-45"
            aria-hidden="true"
          >
            <Icon name="plus" size={15} />
          </span>
        </summary>
        <div class="faq__body">
          <p class="text-navy-300 pr-10 pb-5 text-[0.95rem] leading-relaxed">{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }

  /* Geschlossene <details> blenden ihren Inhalt aus, eine Hoehen-
     Transition greift dort nicht. Stattdessen laeuft beim Oeffnen eine
     kurze Einblendung. */
  .faq[open] .faq__body {
    animation: faq-in 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq[open] .faq__body {
      animation: none;
    }
  }
</style>

<script>
  /* Nur ein Eintrag je Liste gleichzeitig offen. Ohne Script bleibt die
     Liste voll bedienbar, es klappen dann eben mehrere auf. */
  for (const group of document.querySelectorAll('[data-faq-group]')) {
    const items = Array.from(group.querySelectorAll<HTMLDetailsElement>('details.faq'));
    for (const item of items) {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        for (const other of items) if (other !== item) other.open = false;
      });
    }
  }
</script>
