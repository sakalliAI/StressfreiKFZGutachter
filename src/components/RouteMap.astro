---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import routes from '../data/routes.json';
import { projector, type View } from '../lib/projection.mjs';
import { company, type Place } from '../data/site';

/**
 * Karte der Anfahrt vom Buero zu einem Ort.
 *
 * Bild und Route kommen aus zwei Skripten (build-routes, build-route-maps)
 * und werden hier mit derselben Projektion uebereinandergelegt. Die Route
 * zeichnet sich beim Hereinscrollen einmal nach, ohne Bewegung bleibt sie
 * einfach stehen.
 */
interface Props {
  place: Place;
}

const { place } = Astro.props;

type RouteEntry = {
  km: number;
  minutes: number;
  geometry: number[][];
  view: View;
};
const route = (routes.places as Record<string, RouteEntry>)[place.slug];
if (!route) throw new Error(`Keine Route fuer ${place.slug}. node scripts/build-routes.mjs`);

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/orte/*.webp', {
  eager: true,
});
const image = images[`../assets/orte/${place.slug}.webp`]?.default;
if (!image) throw new Error(`Keine Karte fuer ${place.slug}. node scripts/build-route-maps.mjs`);

const { w: W, h: H } = route.view;
const proj = projector(route.view);

const pts = route.geometry.map(([lat = 0, lon = 0]) => proj.toMap(lat, lon));
const d = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
// Laenge fuer die Zeichen-Animation. Grob genuegt, sie wird nur fuer
// stroke-dasharray gebraucht.
let length = 0;
for (let i = 1; i < pts.length; i++) {
  const a = pts[i - 1];
  const b = pts[i];
  if (a && b) length += Math.hypot(b.x - a.x, b.y - a.y);
}
length = Math.ceil(length) + 10;

const office = proj.toMap(company.office.lat, company.office.lon);
const target = proj.toMap(place.lat, place.lon);

// Beschriftungen nach aussen, weg vom jeweils anderen Punkt.
const officeLeft = office.x < target.x;
const SCALE_KM = route.km > 20 ? 10 : 2;
const scalePx = SCALE_KM * proj.pxPerKm;

const alt = `Karte: Anfahrt vom Büro in ${company.city} nach ${place.fullName}, ${route.km.toLocaleString('de-DE')} Kilometer`;
---

<figure class="rounded-card bg-navy-950 overflow-hidden border border-white/10">
  <div class="route-map relative" style={`aspect-ratio:${W}/${H}`} data-route-map>
    <Image
      src={image}
      alt={alt}
      widths={[480, 720, 960]}
      sizes="(min-width: 1280px) 1200px, 100vw"
      format="webp"
      quality={72}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <span
      class="absolute inset-0 bg-[radial-gradient(120%_110%_at_50%_45%,transparent_45%,rgb(4_7_15/0.7)_100%)]"
      aria-hidden="true"></span>

    <svg
      viewBox={`0 0 ${W} ${H}`}
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d={d}
        fill="none"
        stroke="var(--color-copper-500)"
        stroke-opacity="0.28"
        stroke-width="14"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        class="route-line"
        d={d}
        fill="none"
        stroke="var(--color-copper-300)"
        stroke-width="4"
        stroke-linecap="round"
        stroke-linejoin="round"
        style={`--len:${length}`}></path>

      <g>
        <circle
          cx={office.x}
          cy={office.y}
          r="9"
          fill="var(--color-bone-50)"
          stroke="var(--color-navy-950)"
          stroke-width="3"></circle>
        <text
          x={officeLeft ? office.x - 16 : office.x + 16}
          y={office.y + 6}
          text-anchor={officeLeft ? 'end' : 'start'}
          fill="var(--color-bone-50)"
          font-size="19"
          font-weight="700"
          stroke="rgb(4 7 15 / 0.9)"
          stroke-width="5"
          paint-order="stroke">Büro {company.city}</text
        >
      </g>

      <g>
        <circle
          class="route-ping"
          cx={target.x}
          cy={target.y}
          r="22"
          fill="none"
          stroke="var(--color-copper-400)"
          stroke-width="2"></circle>
        <circle
          cx={target.x}
          cy={target.y}
          r="11"
          fill="var(--color-copper-500)"
          stroke="var(--color-navy-950)"
          stroke-width="3"></circle>
        <text
          x={officeLeft ? target.x + 20 : target.x - 20}
          y={target.y + 8}
          text-anchor={officeLeft ? 'start' : 'end'}
          fill="var(--color-bone-50)"
          font-size="24"
          font-weight="800"
          stroke="rgb(4 7 15 / 0.9)"
          stroke-width="6"
          paint-order="stroke">{place.name}</text
        >
      </g>

      <g
        transform={`translate(24 ${H - 24})`}
        stroke="var(--color-bone-50)"
        stroke-opacity="0.75"
        stroke-width="2"
      >
        <line x1="0" y1="0" x2={scalePx} y2="0"></line>
        <line x1="0" y1="-5" x2="0" y2="5"></line>
        <line x1={scalePx} y1="-5" x2={scalePx} y2="5"></line>
        <text
          x={scalePx / 2}
          y="-10"
          text-anchor="middle"
          fill="var(--color-bone-50)"
          stroke="rgb(4 7 15 / 0.85)"
          stroke-width="3.5"
          paint-order="stroke"
          font-size="16"
          font-weight="600">{SCALE_KM} km</text
        >
      </g>
    </svg>

    <p
      class="bg-navy-950/60 text-navy-300 absolute right-0 bottom-0 rounded-tl-md px-2 py-1 text-[0.62rem] leading-none"
    >
      Karte und Route <a
        href="https://www.openstreetmap.org/copyright"
        rel="noopener"
        class="hover:text-bone-100 underline underline-offset-2">© OpenStreetMap</a
      >
    </p>
  </div>
</figure>

<style>
  .route-line {
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
  }

  /* Zeichnet sich nur nach, wenn das Script die Karte scharf geschaltet
     hat. Ohne JavaScript steht die Route einfach fertig da. */
  :global([data-route-map].is-armed) .route-line {
    stroke-dashoffset: var(--len);
  }

  :global([data-route-map].is-drawn) .route-line {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1800ms cubic-bezier(0.45, 0, 0.2, 1);
  }

  .route-ping {
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0;
    animation: route-ping 2800ms ease-out infinite;
  }

  @keyframes route-ping {
    0% {
      transform: scale(0.5);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-ping {
      display: none;
    }
  }
</style>

<script>
  const maps = document.querySelectorAll<HTMLElement>('[data-route-map]');
  if (maps.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          // Ein Frame Abstand, damit der Ausgangszustand gemalt ist, bevor
          // die Uebergang startet.
          requestAnimationFrame(() => el.classList.add('is-drawn'));
          observer.unobserve(el);
        }
      },
      { threshold: 0.35 },
    );
    for (const map of maps) {
      map.classList.add('is-armed');
      observer.observe(map);
    }
  }
</script>
