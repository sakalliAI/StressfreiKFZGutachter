---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { nav, company, services } from '../data/site';

interface Props {
  /** Auf der Startseite fuehren die Punkte zu Sektionen (Scrollspy). */
  home?: boolean;
  /** Aktiver Punkt auf einer Unterseite, etwa 'leistungen'. */
  current?: string | undefined;
}

const { home = false, current } = Astro.props;

/* Auf Unterseiten fuehrt ein Punkt zu seiner eigenen Seite, falls es
   eine gibt, sonst zurueck zur Sektion auf der Startseite. */
const hrefFor = (item: (typeof nav)[number]) =>
  home ? `#${item.id}` : (item.page ?? `/#${item.id}`);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-100 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
  data-header
>
  <div
    class="container-page flex h-[var(--header-h)] items-center justify-between gap-4 transition-[height] duration-400 ease-[cubic-bezier(0.22,1,0.36,1)]"
  >
    <a
      href={home ? '#top' : '/'}
      class="flex items-center rounded-md py-1"
      aria-label="Stressfrei KFZ-Gutachter, zur Startseite"
    >
      <Wordmark />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => {
            const link = (
              <a
                href={hrefFor(item)}
                data-spy-link={home ? item.id : undefined}
                aria-current={!home && current === item.id ? 'true' : undefined}
                class="text-bone-50/90 hover:text-bone-50 aria-[current=true]:text-bone-50 relative block rounded-md px-2.5 py-2 text-[0.88rem] font-medium whitespace-nowrap transition-colors duration-200"
              >
                {item.label}
                <span
                  class="bg-copper-500 absolute inset-x-3 -bottom-0.5 h-0.5 origin-left scale-x-0 rounded-full transition-transform duration-300"
                  data-spy-bar
                  aria-hidden="true"
                />
              </a>
            );
            if (item.id !== 'leistungen') return <li>{link}</li>;

            /* Leistungen mit Untermenue. Der Text bleibt ein normaler
               Link, aufgeklappt wird per Maus beim Darueberfahren oder
               ueber den eigenen Pfeil-Button (Tastatur, Touch). */
            return (
              <li class="relative" data-dd>
                <div class="flex items-center">
                  {link}
                  <button
                    type="button"
                    class="text-bone-50/70 hover:text-bone-50 -ml-2 grid h-9 w-7 place-items-center rounded-md transition-colors"
                    aria-expanded="false"
                    aria-controls="dd-leistungen"
                    aria-label="Untermenü Leistungen"
                    data-dd-toggle
                  >
                    <Icon
                      name="chevron-down"
                      size={15}
                      class="dd-chevron transition-transform duration-200"
                    />
                  </button>
                </div>
                <div
                  id="dd-leistungen"
                  class="dd-panel absolute top-full left-1/2 pt-3"
                  data-dd-panel
                >
                  <div class="bg-navy-900/98 rounded-card w-[36rem] border border-white/10 p-2 shadow-[0_24px_60px_-20px_rgb(0_0_0/0.85)] backdrop-blur-lg">
                    <ul class="grid grid-cols-2 gap-1">
                      {services.map((service) => (
                        <li>
                          <a
                            href={`/leistungen/${service.slug}/`}
                            aria-current={
                              Astro.url.pathname === `/leistungen/${service.slug}/`
                                ? 'page'
                                : undefined
                            }
                            class="group/dd block rounded-lg px-3.5 py-3 transition-colors hover:bg-white/6 aria-[current=page]:bg-white/6"
                          >
                            <span class="text-bone-50 group-hover/dd:text-copper-300 block text-[0.92rem] font-semibold transition-colors">
                              {service.title}
                            </span>
                            <span class="text-navy-300 mt-0.5 block text-[0.8rem] leading-snug">
                              {service.situation}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a
                      href="/leistungen/"
                      class="text-copper-400 hover:text-copper-300 mt-1 flex items-center justify-between rounded-lg border-t border-white/8 px-3.5 pt-3 pb-2.5 text-[0.85rem] font-semibold"
                    >
                      Welches Gutachten brauche ich?
                      <Icon name="arrow-right" size={15} />
                    </a>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={company.phoneHref}
        class="btn btn-ghost hidden !min-h-11 !px-4 !text-[0.85rem] md:inline-flex"
        data-track="call-header"
      >
        <Icon name="phone" size={16} />
        {company.phoneDisplay}
      </a>
      <a
        href={company.whatsapp}
        target="_blank"
        rel="noopener"
        class="btn btn-wa !min-h-11 !px-4 !text-[0.85rem]"
        data-track="wa-header"
      >
        <Icon name="whatsapp" size={17} />
        <span class="hidden sm:inline">WhatsApp</span>
        <span class="sm:hidden">Schreiben</span>
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="text-bone-100 grid h-11 w-11 place-items-center rounded-lg border border-white/15 bg-white/5 transition-colors hover:bg-white/12 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menü öffnen"
      >
        <Icon name="menu" size={20} class="[[aria-expanded=true]_&]:hidden" />
        <Icon name="x" size={20} class="hidden [[aria-expanded=true]_&]:block" />
      </button>
    </div>
  </div>

  {/* Mobiles Menü */}
  <div
    id="mobile-nav"
    class="bg-navy-950/97 grid grid-rows-[0fr] overflow-hidden border-t border-white/8 backdrop-blur-lg transition-[grid-template-rows] duration-350 ease-[cubic-bezier(0.22,1,0.36,1)] lg:hidden"
    data-open="false"
  >
    <div class="min-h-0">
      <nav aria-label="Navigation mobil" class="container-page py-3">
        <ul class="grid gap-0.5">
          {
            nav.map((item) =>
              item.id !== 'leistungen' ? (
                <li>
                  <a
                    href={hrefFor(item)}
                    data-spy-link={home ? item.id : undefined}
                    aria-current={!home && current === item.id ? 'true' : undefined}
                    data-nav-close
                    class="text-navy-300 hover:text-bone-50 aria-[current=true]:text-copper-400 flex min-h-12 items-center justify-between rounded-lg px-3 text-[0.95rem] font-medium transition-colors hover:bg-white/5 aria-[current=true]:bg-white/6"
                  >
                    {item.label}
                    <Icon name="arrow-right" size={16} class="opacity-40" />
                  </a>
                </li>
              ) : (
                <li data-dd>
                  <div class="flex items-center gap-1">
                    <a
                      href={hrefFor(item)}
                      data-spy-link={home ? item.id : undefined}
                      aria-current={!home && current === item.id ? 'true' : undefined}
                      data-nav-close
                      class="text-navy-300 hover:text-bone-50 aria-[current=true]:text-copper-400 flex min-h-12 flex-1 items-center rounded-lg px-3 text-[0.95rem] font-medium transition-colors hover:bg-white/5 aria-[current=true]:bg-white/6"
                    >
                      {item.label}
                    </a>
                    <button
                      type="button"
                      class="text-navy-300 hover:text-bone-50 grid h-12 w-12 place-items-center rounded-lg transition-colors hover:bg-white/5"
                      aria-expanded="false"
                      aria-controls="dd-leistungen-mobil"
                      aria-label="Untermenü Leistungen"
                      data-dd-toggle
                    >
                      <Icon
                        name="chevron-down"
                        size={18}
                        class="dd-chevron transition-transform duration-200"
                      />
                    </button>
                  </div>
                  <ul
                    id="dd-leistungen-mobil"
                    class="mb-1 ml-3 hidden border-l border-white/10 pl-2"
                    data-dd-panel
                  >
                    {services.map((service) => (
                      <li>
                        <a
                          href={`/leistungen/${service.slug}/`}
                          data-nav-close
                          class="text-navy-300 hover:text-bone-50 flex min-h-11 items-center rounded-lg px-3 text-[0.9rem] transition-colors hover:bg-white/5"
                        >
                          {service.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ),
            )
          }
        </ul>
        <a
          href={company.phoneHref}
          class="btn btn-ghost mt-3 w-full"
          data-nav-close
          data-track="call-mobilenav"
        >
          <Icon name="phone" size={17} />
          {company.phoneDisplay}
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  #mobile-nav[data-open='true'] {
    grid-template-rows: 1fr;
  }

  a[aria-current='true'] [data-spy-bar] {
    transform: scaleX(1);
  }

  /* Untermenue Leistungen (Desktop). Verborgen ueber visibility statt
     display, damit es weich ein- und ausblendet. Die kurze Verzoegerung
     beim Schliessen verzeiht es, wenn die Maus kurz aus dem Menue
     rutscht. */
  .dd-panel {
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 180ms;
    transition-delay: 120ms, 120ms, 300ms;
  }

  @media (hover: hover) {
    [data-dd]:hover .dd-panel {
      visibility: visible;
      opacity: 1;
      transform: translate(-50%, 0);
      transition-delay: 0s;
    }
  }

  [data-dd][data-open='true'] .dd-panel {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }

  [data-dd][data-open='true'] [data-dd-panel]:not(.dd-panel) {
    display: block;
  }

  [data-dd][data-open='true'] :global(.dd-chevron) {
    transform: rotate(180deg);
  }

  /* Ganz oben ist der Header durchsichtig. Ueber dem hellen Hero
     braeuchten Logo und Navigation dort sonst Glueck, um lesbar zu
     bleiben, deshalb ein weicher Verlauf darunter. */
  [data-header]::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Reicht ueber die Kopfhoehe hinaus, damit der Verlauf ausklingt
       statt an der Unterkante abzureissen. Der Hero zeigt oben hellen
       Himmel, ohne diese Abdunklung stuenden Logo und Navigation ohne
       jeden Halt darauf. */
    bottom: -70%;
    /* Ohne das liegt der Verlauf ueber dem Inhalt: absolut positionierte
       Pseudo-Elemente werden nach dem nicht positionierten Inhalt des
       Elternelements gezeichnet. Navigation und Schaltflaechen waeren
       dann mit abgedunkelt, am deutlichsten am WhatsApp-Gruen. */
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgb(4 7 15 / 0.93) 0%,
      rgb(4 7 15 / 0.78) 38%,
      rgb(4 7 15 / 0.42) 66%,
      rgb(4 7 15 / 0) 100%
    );
    pointer-events: none;
    transition: opacity 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html[data-scrolled='true']) [data-header]::before {
    opacity: 0;
  }

  /* Erst beim Scrollen bekommt der Header einen eigenen Hintergrund.
     Ganz oben liegt er unsichtbar ueber dem Hero. */
  :global(html[data-scrolled='true']) [data-header] {
    background-color: rgb(6 10 22 / 0.92);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: rgb(255 255 255 / 0.08);
    box-shadow: 0 10px 30px -22px rgb(0 0 0 / 0.9);
  }
</style>

<script>
  /**
   * Scrollspy.
   *
   * Bewusst positionsbasiert statt IntersectionObserver: aktiv ist die
   * letzte Sektion, deren Oberkante noch oberhalb der Header-Unterkante
   * liegt. Damit stimmt die Markierung auch beim Hochscrollen, wo eine
   * reine Sichtbarkeitspruefung faelschlich die erste Sektion waehlt.
   */
  const header = document.querySelector<HTMLElement>('[data-header]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy-link]'));

  const ids = Array.from(new Set(links.map((l) => l.dataset.spyLink ?? '')));
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  let current = '';
  let ticking = false;

  function headerHeight(): number {
    return header?.offsetHeight ?? 68;
  }

  function setActive(id: string): void {
    if (id === current) return;
    current = id;
    for (const link of links) {
      link.setAttribute('aria-current', link.dataset.spyLink === id ? 'true' : 'false');
    }
  }

  function update(): void {
    ticking = false;

    // Am <html>, damit --header-h und --logo-h ueberall greifen.
    document.documentElement.dataset.scrolled = window.scrollY > 12 ? 'true' : 'false';

    if (sections.length === 0) return;

    // Am Seitenende immer die letzte Sektion markieren. Kurze
    // Abschnitte wie der Kontaktblock werden sonst nie aktiv.
    const atBottom =
      window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    if (atBottom) {
      const last = sections[sections.length - 1];
      if (last) setActive(last.id);
      return;
    }

    const line = headerHeight() + 24;
    let active = '';
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= line) active = section.id;
    }
    setActive(active);
  }

  function onScroll(): void {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();

  /* Mobiles Menü */
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');

  function closeNav(): void {
    if (!toggle || !panel) return;
    panel.dataset.open = 'false';
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Menü öffnen');
  }

  toggle?.addEventListener('click', () => {
    if (!panel || !toggle) return;
    const open = panel.dataset.open === 'true';
    panel.dataset.open = open ? 'false' : 'true';
    toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
    toggle.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
  });

  for (const el of document.querySelectorAll('[data-nav-close]')) {
    el.addEventListener('click', closeNav);
  }

  /* Untermenues. Der Button schaltet auf und zu, Escape und ein Klick
     daneben schliessen. Auf dem Desktop oeffnet zusaetzlich Hover per
     CSS, das hier ist fuer Tastatur und Touch. */
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-dd]'));

  function setDropdown(dd: HTMLElement, open: boolean): void {
    dd.dataset.open = open ? 'true' : 'false';
    dd.querySelector('[data-dd-toggle]')?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  for (const dd of dropdowns) {
    dd.querySelector('[data-dd-toggle]')?.addEventListener('click', () => {
      setDropdown(dd, dd.dataset.open !== 'true');
    });
    // Verlaesst der Fokus das Menue per Tab, klappt es zu.
    dd.addEventListener('focusout', (ev) => {
      const next = ev.relatedTarget;
      if (next instanceof Node && !dd.contains(next) && !dd.closest('#mobile-nav')) {
        setDropdown(dd, false);
      }
    });
  }

  document.addEventListener('click', (ev) => {
    for (const dd of dropdowns) {
      if (dd.dataset.open === 'true' && ev.target instanceof Node && !dd.contains(ev.target)) {
        setDropdown(dd, false);
      }
    }
  });

  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    const open = dropdowns.find((dd) => dd.dataset.open === 'true');
    if (open) {
      setDropdown(open, false);
      open.querySelector<HTMLElement>('[data-dd-toggle]')?.focus();
      return;
    }
    closeNav();
  });
</script>
