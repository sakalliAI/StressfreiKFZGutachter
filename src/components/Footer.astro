---
import Icon from './Icon.astro';
import { company, nav } from '../data/site';

const year = new Date().getFullYear();
---

<footer id="footer" class="bg-navy-950 border-t border-white/8">
  <div class="container-page py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)] md:gap-8">
      <div>
        {
          /* Im Footer ist Platz für die vollständige Sperrmarke mit
            Schriftzug. Der separate Text daneben entfällt dadurch. */
        }
        <img
          src="/logo-lockup.webp"
          alt="MK Stressfrei Kfz-Gutachter"
          width="640"
          height="330"
          class="h-24 w-auto sm:h-28"
          loading="lazy"
          decoding="async"
        />
        <p class="text-navy-400 mt-5 max-w-xs text-[0.88rem] leading-relaxed">
          Unabhängige Kfz-Gutachten nach Unfall{company.region ? ` in ${company.region}` : ''}.
          Besichtigung vor Ort, Gutachten direkt an Versicherung und Anwalt.
        </p>
        <a
          href={company.whatsapp}
          target="_blank"
          rel="noopener"
          class="btn btn-wa mt-6"
          data-track="wa-footer"
        >
          <Icon name="whatsapp" size={18} />
          WhatsApp schreiben
        </a>
      </div>

      <nav aria-label="Fußnavigation">
        <h2 class="text-navy-400 text-[0.72rem] font-semibold tracking-[0.16em] uppercase">
          Seite
        </h2>
        <ul class="mt-4 grid gap-2.5">
          {
            nav.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class="text-navy-300 hover:text-gold-400 text-[0.88rem] transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-navy-400 text-[0.72rem] font-semibold tracking-[0.16em] uppercase">
          Direkt
        </h2>
        <ul class="mt-4 grid gap-2.5 text-[0.88rem]">
          <li>
            <a
              href={company.phoneHref}
              class="text-navy-300 hover:text-gold-400 inline-flex items-center gap-2 transition-colors"
              data-track="call-footer"
            >
              <Icon name="phone" size={15} />
              {company.phoneDisplay}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${company.email}`}
              class="text-navy-300 hover:text-gold-400 inline-flex items-center gap-2 break-all transition-colors"
            >
              <Icon name="mail" size={15} />
              {company.email}
            </a>
          </li>
          <li class="text-navy-400 mt-1">{company.hours}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/8 pt-7 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-navy-400 text-[0.8rem]">
        {`© ${year} ${company.name}`}
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <button
          type="button"
          class="text-navy-400 hover:text-bone-100 text-[0.8rem] transition-colors"
          data-legal-open="impressum"
        >
          Impressum
        </button>
        <button
          type="button"
          class="text-navy-400 hover:text-bone-100 text-[0.8rem] transition-colors"
          data-legal-open="datenschutz"
        >
          Datenschutz
        </button>
      </div>
    </div>

    <div class="mt-6 text-center sm:text-right">
      <a
        href="https://sakalli.ai"
        target="_blank"
        rel="noopener noreferrer"
        class="text-navy-400 hover:text-bone-100 text-[11px] transition-colors"
      >
        built by sakalli.ai 🤖
      </a>
    </div>
  </div>
</footer>
