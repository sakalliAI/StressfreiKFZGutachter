---
import { company } from '../data/site';

/**
 * Einsatzgebiet als selbst gezeichnete Karte.
 *
 * Bewusst kein Google Maps und kein Kartendienst: Jede eingebettete
 * Karte lädt beim Aufruf Daten von einem Dritten und wäre damit
 * einwilligungspflichtig. Diese Seite kommt ohne Cookie-Banner aus,
 * das soll so bleiben. Zudem sind es null zusätzliche Anfragen.
 *
 * Die Orte stehen an ihrer ungefähr richtigen Stelle: Entfernung und
 * Peilung ab Ingolstadt stehen in `site.ts`.
 */

const SIZE = 320;
const CENTER = SIZE / 2;
/** Der äußere Ring entspricht dem Einsatzradius. */
const OUTER = 132;
const PX_PER_KM = OUTER / company.radiusKm;

const RINGS = [10, 25, company.radiusKm] as const;

const points = company.places.map((place) => {
  const rad = (place.bearing * Math.PI) / 180;
  return {
    name: place.short ?? place.name,
    x: CENTER + Math.sin(rad) * place.km * PX_PER_KM,
    y: CENTER - Math.cos(rad) * place.km * PX_PER_KM,
    // Beschriftung nach außen kippen, damit sie nicht über die Mitte fällt
    anchor: Math.sin(rad) < -0.2 ? 'end' : 'start',
  };
});
---

<figure class="rounded-card bg-navy-800/70 overflow-hidden border border-white/8">
  <div class="coverage relative">
    <svg
      viewBox={`0 0 ${SIZE} ${SIZE}`}
      class="block h-auto w-full"
      role="img"
      aria-label={`Einsatzgebiet: ${company.city} und rund ${company.radiusKm} Kilometer im Umkreis`}
    >
      <defs>
        <radialGradient id="cov-glow" cx="50%" cy="50%">
          <stop offset="0%" stop-color="var(--color-gold-500)" stop-opacity="0.16"></stop>
          <stop offset="70%" stop-color="var(--color-gold-500)" stop-opacity="0.03"></stop>
          <stop offset="100%" stop-color="var(--color-gold-500)" stop-opacity="0"></stop>
        </radialGradient>
      </defs>

      <circle cx={CENTER} cy={CENTER} r={OUTER} fill="url(#cov-glow)"></circle>

      {/* Entfernungsringe */}
      {
        RINGS.map((km) => (
          <circle
            cx={CENTER}
            cy={CENTER}
            r={km * PX_PER_KM}
            fill="none"
            stroke="var(--color-gold-500)"
            stroke-opacity={km === company.radiusKm ? 0.45 : 0.18}
            stroke-width="1"
            stroke-dasharray={km === company.radiusKm ? '0' : '3 5'}
          />
        ))
      }

      {/* Zwei Achsen als Andeutung von Hauptstraßen */}
      <g stroke="var(--color-navy-600)" stroke-opacity="0.5" stroke-width="1">
        <line x1={CENTER - OUTER} y1={CENTER} x2={CENTER + OUTER} y2={CENTER}></line>
        <line x1={CENTER} y1={CENTER - OUTER} x2={CENTER} y2={CENTER + OUTER}></line>
      </g>

      {/* Ausfahrende Impulse. Die eigentliche Bewegung der Karte. */}
      <g class="coverage-pulse" fill="none" stroke="var(--color-gold-400)" stroke-width="1.5">
        <circle cx={CENTER} cy={CENTER} r={OUTER} style="--d:0ms"></circle>
        <circle cx={CENTER} cy={CENTER} r={OUTER} style="--d:1300ms"></circle>
        <circle cx={CENTER} cy={CENTER} r={OUTER} style="--d:2600ms"></circle>
      </g>

      {/* Umliegende Orte */}
      {
        points.map((point) => (
          <g>
            <circle cx={point.x} cy={point.y} r="3" fill="var(--color-navy-300)" />
            <text
              x={point.anchor === 'end' ? point.x - 7 : point.x + 7}
              y={point.y + 3.5}
              text-anchor={point.anchor}
              fill="var(--color-navy-300)"
              font-size="8.5"
              font-weight="500"
            >
              {point.name}
            </text>
          </g>
        ))
      }

      {/* Standort */}
      <circle cx={CENTER} cy={CENTER} r="7" fill="var(--color-gold-500)"></circle>
      <circle cx={CENTER} cy={CENTER} r="12" fill="none" stroke="var(--color-gold-500)" stroke-opacity="0.5"></circle>
      <text
        x={CENTER - 17}
        y={CENTER + 21}
        text-anchor="end"
        fill="var(--color-bone-50)"
        font-size="11"
        font-weight="700"
      >
        {company.city}
      </text>

      {/* Maßstab */}
      <text
        x={CENTER + 4}
        y={CENTER - OUTER + 13}
        fill="var(--color-gold-400)"
        fill-opacity="0.75"
        font-size="8.5"
      >
        {company.radiusKm} km
      </text>
    </svg>
  </div>

  <figcaption class="border-t border-white/8 p-5">
    <p class="text-bone-50 text-[0.95rem] font-semibold">
      {company.region}
    </p>
    <p class="text-navy-300 mt-1.5 text-[0.86rem] leading-relaxed">
      Ich fahre raus, wo Ihr Fahrzeug steht. Werkstatt, Zuhause, Abstellplatz oder direkt zur
      Unfallstelle.
    </p>
  </figcaption>
</figure>

<style>
  .coverage-pulse circle {
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0;
    animation: coverage-pulse 3900ms ease-out infinite;
    animation-delay: var(--d);
  }

  @keyframes coverage-pulse {
    0% {
      transform: scale(0.08);
      opacity: 0;
    }
    12% {
      opacity: 0.55;
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverage-pulse {
      display: none;
    }
  }
</style>
