---
import { Image } from 'astro:assets';
import { company } from '../data/site';
import mapImage from '../assets/karte-einsatzgebiet.webp';
import { MAP_H, MAP_W, pxPerKm, toMap } from '../data/map-config.mjs';

/**
 * Einsatzgebiet auf einer echten Karte.
 *
 * Der Untergrund stammt von OpenStreetMap, wird aber beim Bauen der
 * Seite einmal geholt und liegt danach als Bild im Projekt. Zur
 * Laufzeit geht damit keine einzige Anfrage an einen Dritten hinaus.
 * Deshalb braucht die Seite weiterhin kein Einwilligungsfenster.
 * Erzeugt von `scripts/build-map.mjs`.
 *
 * Marken und Ringe liegen als SVG darüber und rechnen mit derselben
 * Projektion wie das Bild, siehe `src/data/map-config.mjs`. Das SVG hat
 * genau das Seitenverhältnis des Bildes, sonst würden die Marken
 * verrutschen.
 */

const PX_KM = pxPerKm();
const CX = MAP_W / 2;
const CY = MAP_H / 2;

const points = company.places.map((place) => ({
  name: place.name,
  ...toMap(place.lat, place.lon),
}));

/** Maßstabsbalken unten links. */
const SCALE_KM = 25;
const SCALE_PX = SCALE_KM * PX_KM;
---

<figure class="rounded-card bg-navy-800/70 overflow-hidden border border-white/8">
  <div class="relative" style={`aspect-ratio:${MAP_W}/${MAP_H}`}>
    <Image
      src={mapImage}
      alt={`Karte der Region um ${company.city} mit den Orten, in denen ich Gutachten erstelle`}
      widths={[440, 660, 880]}
      sizes="(min-width: 1024px) 34vw, 100vw"
      format="webp"
      quality={66}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- Randabdunklung, damit die Karte in die Kachel einsinkt -->
    <span
      class="absolute inset-0 bg-[radial-gradient(115%_95%_at_50%_45%,transparent_38%,rgb(4_7_15/0.62)_100%)]"
      aria-hidden="true"></span>

    <svg
      viewBox={`0 0 ${MAP_W} ${MAP_H}`}
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <radialGradient id="cov-reach" cx="50%" cy="50%">
          <stop offset="0%" stop-color="var(--color-gold-400)" stop-opacity="0.2"></stop>
          <stop offset="45%" stop-color="var(--color-gold-400)" stop-opacity="0.1"></stop>
          <stop offset="100%" stop-color="var(--color-gold-400)" stop-opacity="0"></stop>
        </radialGradient>
      </defs>

      <!-- Reichweite als weicher Verlauf statt harter Kante. Ein Kreis
           mit klarer Linie wuerde eine Grenze behaupten, die es so
           nicht gibt. -->
      <circle cx={CX} cy={CY} r={company.radiusKm * PX_KM} fill="url(#cov-reach)"></circle>

      <!-- Entfernungsringe. Ohne Beschriftung, die Entfernung liest man
           am Maßstab unten links ab. -->
      {
        [10, 25].map((km) => (
          <circle
            cx={CX}
            cy={CY}
            r={km * PX_KM}
            fill="none"
            stroke="var(--color-gold-400)"
            stroke-opacity="0.3"
            stroke-width="1.4"
            stroke-dasharray="5 7"
          />
        ))
      }

      <!-- Orte im Einsatzgebiet -->
      {
        points.map((point) => (
          <g>
            <circle
              cx={point.x}
              cy={point.y}
              r="9"
              fill="var(--color-gold-400)"
              fill-opacity="0.2"
            />
            <circle
              cx={point.x}
              cy={point.y}
              r="4.5"
              fill="var(--color-gold-400)"
              stroke="var(--color-navy-950)"
              stroke-width="1.5"
            />
          </g>
        ))
      }

      <!-- Standort -->
      <circle
        class="coverage-ping"
        cx={CX}
        cy={CY}
        r="30"
        fill="none"
        stroke="var(--color-gold-400)"
        stroke-width="2"></circle>
      <circle
        cx={CX}
        cy={CY}
        r="11"
        fill="var(--color-gold-500)"
        stroke="var(--color-navy-950)"
        stroke-width="2.5"></circle>
      <text
        x={CX}
        y={CY + 34}
        text-anchor="middle"
        fill="var(--color-bone-50)"
        font-size="21"
        font-weight="700"
        stroke="rgb(4 7 15 / 0.85)"
        stroke-width="4"
        paint-order="stroke"
      >
        {company.city}
      </text>

      <!-- Maßstab -->
      <g transform={`translate(28 ${MAP_H - 30})`}>
        <line
          x1="0"
          y1="0"
          x2={SCALE_PX}
          y2="0"
          stroke="var(--color-bone-50)"
          stroke-opacity="0.72"
          stroke-width="2"></line>
        <line
          x1="0"
          y1="-5"
          x2="0"
          y2="5"
          stroke="var(--color-bone-50)"
          stroke-opacity="0.72"
          stroke-width="2"></line>
        <line
          x1={SCALE_PX}
          y1="-5"
          x2={SCALE_PX}
          y2="5"
          stroke="var(--color-bone-50)"
          stroke-opacity="0.72"
          stroke-width="2"></line>
        <text
          x={SCALE_PX / 2}
          y="-9"
          text-anchor="middle"
          fill="var(--color-bone-50)"
          fill-opacity="0.8"
          font-size="15"
          font-weight="600">{SCALE_KM} km</text
        >
      </g>
    </svg>

    <!-- Namensnennung. Die ODbL verlangt sie sichtbar an der Karte,
         deshalb steht sie im Bild und nicht im Kleingedruckten. -->
    <p
      class="bg-navy-950/55 text-navy-300 absolute right-0 bottom-0 rounded-tl-md px-2 py-1 text-[0.6rem] leading-none"
    >
      Karte <a
        href="https://www.openstreetmap.org/copyright"
        rel="noopener"
        class="hover:text-bone-100 underline underline-offset-2">© OpenStreetMap</a
      >
    </p>
  </div>

  <figcaption class="border-t border-white/8 px-4 py-4">
    <p class="text-bone-50 text-[0.92rem] font-semibold">
      {company.region}, rund {company.radiusKm} km im Umkreis
    </p>
    <ul class="mt-2.5 flex flex-wrap gap-1.5">
      {
        company.places.map((place) => (
          <li class="bg-navy-700/60 text-navy-300 rounded-full px-2.5 py-1 text-[0.73rem] font-medium">
            {place.name}
          </li>
        ))
      }
    </ul>
  </figcaption>
</figure>

<style>
  /* Ein einzelner Impuls am Standort. Genug Bewegung, damit die Karte
     nicht wie ein Screenshot wirkt, wenig genug, um nicht zu stoeren. */
  .coverage-ping {
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0;
    animation: coverage-ping 3400ms ease-out infinite;
  }

  @keyframes coverage-ping {
    0% {
      transform: scale(0.35);
      opacity: 0;
    }
    18% {
      opacity: 0.6;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coverage-ping {
      display: none;
    }
  }
</style>
