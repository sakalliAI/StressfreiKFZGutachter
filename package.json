{
  "name": "mk-stressfrei",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website MK Stressfrei KFZ Gutachter",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.mjs,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.astro --fix",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,mjs,json,css,md}\"",
    "deploy": "npm run build && wrangler pages deploy dist --project-name mk-stressfrei --branch main"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.4.1",
    "globals": "^17.8.0",
    "playwright": "^1.62.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.45.0"
  }
}
